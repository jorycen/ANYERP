/* 全局样式变量 */
:root {
  --primary-color: #1AAD19;
  --secondary-color: #FF9800;
  --text-color: #333333;
  --light-text: #999999;
  --border-color: #E5E5E5;
  --background-color: #F5F5F5;
  --success-color: #4CAF50;
  --danger-color: #F44336;
  --warning-color: #FFC107;
}

/* 基础样式重置 */
page {
  background-color: var(--background-color);
  color: var(--text-color);
  font-size: 32rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

view, text, button, input, image {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

/* 通用按钮样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.btn-primary:active {
  background-color: #179116;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.btn-secondary:active {
  background-color: #F0F0F0;
}

.btn-danger {
  background-color: var(--danger-color);
  color: #FFFFFF;
}

.btn-danger:active {
  background-color: #D32F2F;
}

/* 通用表单样式 */
.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.form-item-label {
  font-size: 28rpx;
  color: var(--light-text);
  margin-bottom: 10rpx;
}

.form-item-input {
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 32rpx;
}

.form-item-input:focus {
  border-color: var(--primary-color);
  outline: none;
}

/* 通用列表样式 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #FFFFFF;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

/* 通用卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 30rpx;
  margin-bottom: 30rpx;
}

/* 金额样式 */
.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--danger-color);
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: var(--text-color);
}

/* 副标题样式 */
.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: var(--text-color);
}

/* 分隔线样式 */
.divider {
  height: 2rpx;
  background-color: var(--border-color);
  margin: 20rpx 0;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: var(--light-text);
}

/* 加载状态样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 50rpx 0;
}

/* 隐藏元素 */
.hidden {
  display: none;
}

/* 弹性布局工具类 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 边距工具类 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

/* 内边距工具类 */
.p-10 { padding: 10rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }
.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }