NODE_ENV=development
PORT=3000

DB_HOST=your-server-mysql-host
DB_PORT=3306
DB_NAME=any_erp
DB_USER=your-server-mysql-user
DB_PASSWORD=your-server-mysql-password
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_ACQUIRE_MS=10000
DB_POOL_IDLE_MS=60000
DB_POOL_EVICT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_RETRY_MAX=3
DB_ACTIVATION_RETRY_DELAYS_MS=1000,2000,4000,8000,16000
DB_STARTUP_RECOVERY_RETRY_MS=60000

JWT_SECRET=replace-with-a-strong-secret
