# Copy this file to cloud-db.env and fill in the real cloud database connection.
# Do not commit cloud-db.env.

DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_NAME=any_erp
DB_USER=your-cloud-mysql-user
DB_PASSWORD=your-cloud-mysql-password
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_ACQUIRE_MS=10000
DB_POOL_IDLE_MS=60000
DB_POOL_EVICT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_RETRY_MAX=3
DB_ACTIVATION_RETRY_DELAYS_MS=1000,2000,4000,8000,16000
DB_STARTUP_RECOVERY_RETRY_MS=60000
DB_HEARTBEAT_ENABLED=true
DB_HEARTBEAT_START_TIME=09:30
DB_HEARTBEAT_END_TIME=23:00
DB_HEARTBEAT_INTERVAL_MS=420000
DB_HEARTBEAT_TIMEZONE=Asia/Shanghai
DB_HEARTBEAT_RETRY_MAX=3
DB_HEARTBEAT_RETRY_DELAY_MS=2000
