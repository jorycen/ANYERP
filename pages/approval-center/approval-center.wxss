.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #5b3cc4, #7957d5);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 60, 196, 0.22);
}

.mode-tabs { display: flex; margin-top: 20rpx; padding: 6rpx; border-radius: 12rpx; background: #fff; }
.mode-tab { flex: 1; padding: 16rpx 0; border-radius: 9rpx; color: #667085; font-size: 25rpx; text-align: center; }
.mode-tab.active { background: #f0ebff; color: #5b3cc4; font-weight: 600; }
.history-search { margin: 18rpx 0; padding: 18rpx; border-radius: 14rpx; background: #fff; }
.history-search-row { display: flex; align-items: center; gap: 12rpx; }
.history-input { flex: 1; min-width: 0; padding: 17rpx 18rpx; border: 1rpx solid #e2e6ec; border-radius: 10rpx; color: #344054; font-size: 23rpx; }
.history-search-button { flex: 0 0 100rpx; margin: 0; padding: 0; background: #5b3cc4; color: #fff; font-size: 24rpx; line-height: 68rpx; }
.history-status { margin-top: 16rpx; padding: 15rpx 18rpx; border: 1rpx solid #e2e6ec; border-radius: 10rpx; color: #667085; font-size: 23rpx; }
.history-readonly-tip { padding: 18rpx; color: #667085; background: #f8f9fc; font-size: 24rpx; text-align: center; }

.summary-title,
.summary-subtitle {
  display: block;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 600;
}

.summary-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.total-badge {
  width: 86rpx;
  height: 86rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 86rpx;
  text-align: center;
}

.filter-scroll {
  width: 100%;
  margin: 22rpx 0 18rpx;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 20rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 30rpx;
  background: #fff;
  color: #667085;
  font-size: 25rpx;
}

.filter-item.active {
  border-color: #6847ca;
  background: #f0ebff;
  color: #5b3cc4;
  font-weight: 600;
}

.filter-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 8rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-radius: 17rpx;
  background: #f2f4f7;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.filter-item.active .filter-count {
  background: #fff;
}

.partial-error {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #fff3e8;
  color: #b54708;
  font-size: 23rpx;
}

.task-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(31, 45, 61, 0.06);
}

.task-card:active {
  background: #fafafa;
}

.task-head,
.task-meta,
.task-foot,
.detail-head,
.detail-row,
.business-item,
.review-actions {
  display: flex;
  align-items: center;
}

.task-head,
.task-foot,
.detail-head,
.detail-row,
.business-item {
  justify-content: space-between;
}

.attachment-section { margin-top: 28rpx; }
.photo-strip { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.photo-thumb { width: 126rpx; height: 126rpx; border-radius: 12rpx; background: #eee; }
.attachment-file-list { margin-top: 16rpx; }
.attachment-file { display: flex; align-items: center; min-height: 72rpx; padding: 0 18rpx; border-radius: 10rpx; background: #f8f9fb; }
.attachment-file + .attachment-file { margin-top: 10rpx; }
.attachment-file-icon { margin-right: 12rpx; font-size: 28rpx; }
.attachment-file-name { flex: 1; overflow: hidden; color: #475467; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.attachment-file-action { margin-left: 16rpx; color: #5b3cc4; font-size: 23rpx; }

.type-tag {
  display: inline-block;
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.type-tag.sales {
  color: #175cd3;
  background: #eff8ff;
}

.type-tag.purchase {
  color: #b54708;
  background: #fff4e5;
}

.type-tag.product {
  color: #087443;
  background: #ecfdf3;
}

.type-tag.return {
  color: #b42318;
  background: #fef3f2;
}

.type-tag.resource {
  color: #6941c6;
  background: #f4f0ff;
}

.type-tag.profit {
  color: #c11574;
  background: #fdf2fa;
}

.stage {
  color: #d97706;
  font-size: 23rpx;
}

.task-no {
  display: block;
  margin-top: 18rpx;
  color: #667085;
  font-size: 23rpx;
}

.task-title {
  display: block;
  margin-top: 8rpx;
  color: #1d2939;
  font-size: 30rpx;
  font-weight: 600;
}

.task-summary {
  display: block;
  margin-top: 12rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.55;
}

.task-meta {
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 23rpx;
}

.task-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f4;
}

.amount-label {
  color: #98a2b3;
  font-size: 22rpx;
}

.amount {
  margin-left: 10rpx;
  color: #ef6c00;
  font-size: 28rpx;
  font-weight: 600;
}

.review-link {
  margin-left: auto;
  color: #5b3cc4;
  font-size: 25rpx;
}

.loading-state,
.empty-state {
  color: #98a2b3;
  text-align: center;
}

.loading-state {
  padding: 130rpx 0;
  font-size: 27rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eafaf1;
  color: #07883f;
  font-size: 44rpx;
  line-height: 96rpx;
}

.empty-title {
  margin-top: 22rpx;
  color: #475467;
  font-size: 29rpx;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(16, 24, 40, 0.55);
}

.detail-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 88vh;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 14rpx auto 2rpx;
  border-radius: 4rpx;
  background: #d0d5dd;
}

.detail-head {
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.detail-no {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.close {
  width: 64rpx;
  height: 64rpx;
  color: #98a2b3;
  font-size: 46rpx;
  line-height: 60rpx;
  text-align: center;
}

.detail-scroll {
  height: calc(88vh - 190rpx);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.detail-title,
.detail-summary {
  display: block;
}

.detail-title {
  color: #1d2939;
  font-size: 32rpx;
  font-weight: 600;
}

.detail-summary {
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}

.detail-grid {
  margin-top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.detail-row {
  align-items: flex-start;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eaecf0;
  color: #667085;
  font-size: 24rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row text:last-child {
  flex: 1;
  color: #1d2939;
  text-align: right;
  word-break: break-all;
}

.item-section,
.comment-section {
  margin-top: 26rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #344054;
  font-size: 27rpx;
  font-weight: 600;
}

.business-item {
  gap: 20rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #edf0f4;
}

.line-main {
  flex: 1;
  min-width: 0;
}

.line-name,
.line-meta {
  display: block;
}

.line-name {
  color: #1d2939;
  font-size: 25rpx;
}

.line-meta {
  margin-top: 5rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.line-number {
  color: #667085;
  font-size: 23rpx;
  text-align: right;
}

.line-number text {
  display: block;
}

.comment-input {
  width: 100%;
  height: 150rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  background: #fff;
  color: #1d2939;
  font-size: 26rpx;
}

.comment-count {
  display: block;
  margin-top: 7rpx;
  color: #98a2b3;
  font-size: 21rpx;
  text-align: right;
}

.scroll-space {
  height: 130rpx;
}

.review-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 18rpx;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eaecf0;
  background: #fff;
}

.reject-button,
.approve-button {
  height: 78rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  line-height: 78rpx;
}

.reject-button {
  width: 210rpx;
  border: 1rpx solid #fda29b;
  background: #fff;
  color: #d92d20;
}

.approve-button {
  flex: 1;
  background: #07c160;
  color: #fff;
}

.load-more-area {
  padding: 12rpx 24rpx 28rpx;
  text-align: center;
}

.load-more-button {
  height: 68rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  background: #fff;
  color: #475467;
  font-size: 24rpx;
  line-height: 68rpx;
}

.detail-loading {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 24rpx;
  text-align: center;
}

.product-edit-section {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #d6bbff;
  border-radius: 14rpx;
  background: #fbfaff;
}

.product-edit-section .section-title {
  display: block;
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin: 16rpx 0 8rpx;
  color: #475467;
  font-size: 24rpx;
}

.edit-input,
.edit-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d0d5dd;
  border-radius: 10rpx;
  background: #fff;
  color: #1d2939;
  font-size: 25rpx;
}

.edit-input {
  height: 70rpx;
  padding: 0 16rpx;
}

.edit-textarea {
  min-height: 120rpx;
  padding: 14rpx 16rpx;
}

.edit-readonly {
  display: block;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 25rpx;
}

.attribute-edit-row + .attribute-edit-row {
  margin-top: 12rpx;
}

.attribute-edit-label {
  display: block;
  margin-bottom: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.edit-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  color: #344054;
  font-size: 25rpx;
}

.edit-tip {
  display: block;
  margin-top: 16rpx;
  color: #6941c6;
  font-size: 22rpx;
}
