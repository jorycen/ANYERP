/* pages/profile/profile.wxss */
.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background-color: var(--background-color);
}

/* 页面标题 */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-align: center;
}

/* 个人中心区块 */
.profile-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
  display: block;
}

.section-desc {
  display: block;
  margin: -16rpx 0 24rpx;
  color: var(--light-text);
  font-size: 24rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 30rpx;
}

.info-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.info-value {
  font-size: 32rpx;
  color: var(--text-color);
  font-weight: bold;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
  cursor: pointer;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 32rpx;
  color: var(--text-color);
}

.setting-arrow {
  font-size: 32rpx;
  color: var(--light-text);
}

/* 按钮样式 */
.btn {
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
  width: 100%;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

/* 版本信息样式 */
.version-section {
  text-align: center;
  padding: 30rpx 0;
  margin-top: 20rpx;
}

.version-text {
  font-size: 24rpx;
  color: var(--light-text);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: 10rpx;
  }
}

/* 门店选择弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-picker-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-height: 70vh;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 1001;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
}

.store-list-container {
  max-height: 60vh;
}

.store-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.store-item:last-child {
  border-bottom: none;
}

.store-item.selected {
  background-color: #e8f4ff;
}

.store-item:active {
  background-color: #f0f0f0;
}

.store-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.store-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.store-item-address {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.store-item-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}
