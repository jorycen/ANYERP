/* 门店信息编辑页面样式 */
.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background-color: var(--background-color);
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.store-form {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.form-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
  display: block;
}

.sub-title {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 15rpx;
  display: block;
}

.form-item {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.form-input {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 80rpx;
  box-sizing: border-box;
}

.form-textarea {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 120rpx;
  box-sizing: border-box;
  resize: none;
}

.staff-list {
  margin-top: 20rpx;
}

.staff-item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 15rpx;
  align-items: flex-start;
}

.staff-item .form-input {
  flex: 1;
}

.btn-add {
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  background-color: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: 6rpx;
  margin-top: 10rpx;
  width: 100%;
}

.btn-delete {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background-color: var(--danger-color);
  color: #FFFFFF;
  border: none;
  border-radius: 6rpx;
  min-height: auto;
  line-height: normal;
  margin: 0;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  padding: 20rpx;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}