<view class="container">
  <view class="header">
    <text class="title">客户来源管理</text>
  </view>

  <view class="action-bar">
    <button class="btn-add-primary" bindtap="addLevel1">
      <text class="btn-icon">+</text>新增一级来源
    </button>
  </view>

  <view class="source-list">
    <block wx:if="{{level1Sources && level1Sources.length > 0}}">
      <view class="level1-card" wx:for="{{level1Sources}}" wx:key="_id">
        <view class="level1-header" bindtap="toggleExpand" data-id="{{item._id}}">
          <view class="level1-left">
            <text class="expand-icon">{{expandedLevels[item._id] ? '▼' : '▶'}}</text>
            <text class="level1-name">{{item.name}}</text>
          </view>
          <view class="level1-right">
            <text class="sort-badge">排序 {{item.sortOrder || 0}}</text>
          </view>
        </view>

        <view class="level2-wrapper" wx:if="{{expandedLevels[item._id]}}">
          <view class="level2-list">
            <block wx:if="{{level2SourcesMap[item._id] && level2SourcesMap[item._id].length > 0}}">
              <view class="level2-item" wx:for="{{level2SourcesMap[item._id]}}" wx:for-item="l2" wx:key="_id">
                <view class="level2-content">
                  <text class="level2-dot">•</text>
                  <text class="level2-name">{{l2.name}}</text>
                  <text class="level2-sort">{{l2.sortOrder || 0}}</text>
                </view>
                <view class="level2-actions">
                  <view class="action-btn edit" bindtap="startEditLevel2" data-parentid="{{item._id}}" data-index="{{index}}">编辑</view>
                  <view class="action-btn delete" bindtap="deleteLevel2" data-id="{{l2._id}}" data-name="{{l2.name}}">删除</view>
                </view>
              </view>
            </block>
            <view class="level2-empty" wx:else>
              <text>暂无二级来源</text>
            </view>
          </view>

          <view class="level1-actions">
            <view class="action-btn add" bindtap="addLevel2" data-parentid="{{item._id}}" data-parentname="{{item.name}}">+ 添加二级来源</view>
            <view class="action-btn edit" bindtap="startEditLevel1" data-index="{{index}}">编辑一级</view>
            <view class="action-btn delete" bindtap="deleteLevel1" data-id="{{item._id}}" data-name="{{item.name}}">删除</view>
          </view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:else>
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无客户来源</text>
      <text class="empty-hint">点击上方按钮新增</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="closeAddModal" catchtouchmove="noop"></view>
  <view class="modal" wx:if="{{showAddModal}}" catchtouchmove="noop">
    <view class="modal-content" catchtouchmove="noop">
      <view class="modal-header">
        <text class="modal-title">{{addLevel === 1 ? '新增一级来源' : '新增二级来源'}}</text>
        <text class="modal-close" bindtap="closeAddModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item" wx:if="{{addLevel === 2}}">
          <text class="form-label">父级来源</text>
          <text class="form-value-text">{{newParentName}}</text>
        </view>
        <view class="form-item">
          <text class="form-label">来源名称</text>
          <input class="form-input" type="text" placeholder="请输入来源名称" value="{{newName}}" bindinput="onNewNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">排序号</text>
          <input class="form-input" type="number" placeholder="数字越小越靠前" value="{{newSortOrder}}" bindinput="onNewSortInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeAddModal">取消</button>
        <button class="btn-confirm" bindtap="saveNewItem">保存</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal" catchtouchmove="noop"></view>
  <view class="modal" wx:if="{{showEditModal}}" catchtouchmove="noop">
    <view class="modal-content" catchtouchmove="noop">
      <view class="modal-header">
        <text class="modal-title">编辑来源</text>
        <text class="modal-close" bindtap="closeEditModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item" wx:if="{{editLevel === 2}}">
          <text class="form-label">父级来源</text>
          <text class="form-value-text">{{editParentName}}</text>
        </view>
        <view class="form-item">
          <text class="form-label">来源名称</text>
          <input class="form-input" type="text" placeholder="请输入来源名称" value="{{editName}}" bindinput="onEditNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">排序号</text>
          <input class="form-input" type="number" placeholder="数字越小越靠前" value="{{editSortOrder}}" bindinput="onEditSortInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeEditModal">取消</button>
        <button class="btn-confirm" bindtap="saveEditItem">保存</button>
      </view>
    </view>
  </view>
</view>
