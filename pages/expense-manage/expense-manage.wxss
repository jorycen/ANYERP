.page { min-height: 100vh; padding: 24rpx; background: #f5f6f8; box-sizing: border-box; }
.card { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.05); }
.section-title { display: block; margin-bottom: 24rpx; font-size: 34rpx; font-weight: 600; color: #1f2937; }
.field-label { display: block; margin: 22rpx 0 10rpx; font-size: 26rpx; color: #374151; }
.required::after { content: " *"; color: #e5484d; }
.input, .picker-value, .readonly-value, .textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #dfe3e8; border-radius: 10rpx; background: #fff; font-size: 28rpx; }
.input, .picker-value, .readonly-value { min-height: 82rpx; padding: 20rpx; }
.textarea { min-height: 150rpx; padding: 20rpx; }
.readonly-value { color: #6b7280; background: #f7f8fa; }
.placeholder { color: #a0a6ad; }
.two-columns { display: flex; gap: 20rpx; }
.column { flex: 1; min-width: 0; }
.field-tip { display: block; margin-top: 10rpx; color: #77808c; font-size: 23rpx; line-height: 1.5; }
.switch-row { display: flex; justify-content: space-between; align-items: center; margin-top: 26rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eef0f2; font-size: 28rpx; }
.submit-btn { margin-top: 30rpx; background: #1aad19; color: #fff; border-radius: 10rpx; }
.empty { padding: 34rpx 0; text-align: center; color: #969da6; }
.record { padding: 22rpx 0; border-bottom: 1rpx solid #edf0f2; }
.record:last-child { border-bottom: 0; }
.record-head, .record-foot { display: flex; justify-content: space-between; align-items: center; }
.record-no { font-size: 25rpx; color: #5d6670; }
.record-title { display: block; margin: 12rpx 0 8rpx; font-size: 29rpx; color: #20252b; }
.stage-row { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 10rpx; background: #f7faf8; }
.stage-label { color: #6b7280; font-size: 24rpx; }
.stage-value { color: #1aad19; font-size: 26rpx; font-weight: 600; }
.record-action-row { display: flex; justify-content: flex-end; margin-top: 14rpx; }
.review-info { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 10rpx; color: #606266; background: #f7f9fb; font-size: 23rpx; line-height: 1.5; }
.detail-btn { margin: 14rpx 0 0; padding: 0 22rpx; border: 1rpx solid #b7c9e8; border-radius: 8rpx; color: #3568a8; background: #f4f8ff; font-size: 24rpx; line-height: 58rpx; }
.revoke-btn { margin: 0; padding: 0 22rpx; border: 1rpx solid #e5484d; border-radius: 8rpx; color: #d93025; background: #fff5f5; font-size: 24rpx; line-height: 58rpx; }
.muted { color: #7c858f; font-size: 24rpx; }
.amount { color: #d94f3d; font-size: 30rpx; font-weight: 600; }
.status { padding: 5rpx 12rpx; border-radius: 999rpx; background: #eef2f6; color: #66717d; font-size: 22rpx; }
.status-pending_approval { background: #fff3d6; color: #a66b00; }
.status-approved, .status-pending_payment { background: #e8f2ff; color: #1769aa; }
.status-paid { background: #e7f7e8; color: #218838; }
.status-rejected, .status-cancelled { background: #fde9e7; color: #bd392f; }
