/* pages/order-detail/order-detail.wxss */

/* textarea 只读样式 - 用于可复制文本 */
.order-no-textarea,
.remark-textarea,
.readonly-textarea,
.readonly-textarea-small,
.imei-textarea,
.supplement-content-textarea,
.supplement-meta-textarea,
.goods-select-name-textarea,
.goods-select-pn-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.5;
}

.order-no-textarea {
  font-size: 26rpx;
  color: var(--light-text);
  font-family: monospace;
  width: auto;
  min-width: 0;
  white-space: nowrap;
  display: inline-block;
}

.remark-textarea {
  padding: 20rpx;
  background-color: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
}

.readonly-textarea {
  padding: 15rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.readonly-textarea-small {
  padding: 10rpx 15rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.imei-textarea {
  font-size: 24rpx;
  color: var(--text-color);
  margin-right: 16rpx;
  height: 60rpx;
  min-height: 60rpx;
  max-height: 80rpx;
  padding: 10rpx 15rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.supplement-content-textarea {
  font-size: 26rpx;
  color: var(--text-color);
  line-height: 1.5;
  margin: 10rpx 0;
}

.supplement-meta-textarea {
  font-size: 24rpx;
  color: var(--light-text);
}

.goods-select-name-textarea {
  font-size: 28rpx;
  color: var(--text-color);
}

.goods-select-pn-textarea {
  font-size: 24rpx;
  color: var(--light-text);
}

/* 表单字段 textarea 样式（通用） */
.field-input-textarea {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 120rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  margin: 0;
  line-height: 1.5;
  box-sizing: border-box;
  overflow-y: auto;
}

/* 商品信息中的 textarea 样式 - 统一高度 */
.code-input-textarea {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 100rpx;
  width: 100%;
  color: var(--text-color);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  margin: 0;
  line-height: 1.5;
  box-sizing: border-box;
  overflow-y: auto;
}

.name-textarea {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 100rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  margin: 0;
  line-height: 1.5;
  box-sizing: border-box;
  overflow-y: auto;
}

.input-number-textarea {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 100rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  margin: 0;
  line-height: 1.5;
  box-sizing: border-box;
  overflow-y: auto;
}

.input-discount-textarea {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 120rpx;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 容器样式 */
.container {
  padding: 20rpx 30rpx 40rpx;
  min-height: 100vh;
  background-color: var(--background-color);
  box-sizing: border-box;
}

/* 头部样式 */
.header {
  margin-bottom: 20rpx;
  padding: 0;
  background-color: transparent;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-align: left;
}

.order-no {
  font-size: 26rpx;
  color: var(--light-text);
  font-family: monospace;
  user-select: text;
  -webkit-user-select: text;
}

/* 状态标签 */
.status-badge {
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.status-badge.pending {
  background-color: #FEF3C7;
  color: #D97706;
}

.status-badge.archived {
  background-color: #D1FAE5;
  color: #059669;
}

/* 编辑/只读模式提示 */
.edit-mode-banner,
.readonly-banner {
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.edit-mode-banner {
  background-color: #DBEAFE;
  border: 2rpx solid #93C5FD;
}

.edit-mode-text {
  font-size: 28rpx;
  color: #1E40AF;
  font-weight: 500;
}

.readonly-banner {
  background-color: #F3F4F6;
  border: 2rpx solid #D1D5DB;
}

.readonly-text {
  font-size: 28rpx;
  color: var(--light-text);
  user-select: text;
  -webkit-user-select: text;
}

/* 区块卡片样式 - 与新建订单一致 */
.section-card {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  margin-top: 0;
  padding-top: 0;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
}

.section-hint {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-left: 10rpx;
}

.section-subheader {
  margin-top: 20rpx;
  margin-bottom: 15rpx;
}

.section-subtitle {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.section-content {
  padding: 0;
}

/* 表单网格 */
.form-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.flex-1 {
  flex: 1;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.field-label.required::after {
  content: ' *';
  color: #FF4444;
}

.field-label-small {
  font-size: 24rpx;
  color: var(--light-text);
}

.field-label-small.required::after {
  content: ' *';
  color: #FF4444;
}

.inventory-status-label {
  flex: 0 0 auto;
  max-width: 45%;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #9a6700;
  background: #fff7d6;
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-label-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.amount-minus {
  color: #e64340;
  font-size: 30rpx;
  line-height: 64rpx;
  margin-right: 4rpx;
}

.field-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.header-sn-picker {
  width: 36rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.header-sn-picker-arrow {
  width: 36rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-sn-picker-arrow .picker-arrow {
  font-size: 22rpx;
  color: #666;
}

.field-input,
.picker-input,
.field-textarea {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx 40rpx 15rpx 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 80rpx;
  box-sizing: border-box;
  position: relative;
}

.field-input.disabled,
.picker-input.disabled {
  background-color: #f0f0f0;
  color: #999;
  border-color: #e0e0e0;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.field-textarea {
  height: auto;
  min-height: 160rpx;
  padding: 20rpx;
  line-height: 1.6;
}

/* 按钮样式 */
.btn-add {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  background-color: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
}

.btn-add::after {
  border: none;
}

/* 商品信息标题行的操作按钮始终贴齐卡片最右侧 */
.section-header .btn-add {
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
}

.btn-delete {
  font-size: 26rpx;
  width: 100%;
  min-height: 80rpx;
  padding: 0;
  margin: 0;
  background-color: var(--danger-color);
  color: #FFFFFF;
  border: none;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.btn-delete::after {
  border: none;
}

.btn-delete-small {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  background-color: var(--danger-color);
  color: white;
  border-radius: 6rpx;
  border: none;
  line-height: 1;
}

.btn-delete-small::after {
  border: none;
}

/* 商品表头样式 */
.goods-header {
  display: flex;
  background-color: var(--primary-color);
  color: #FFFFFF;
  padding: 15rpx 20rpx;
  border-radius: 8rpx 8rpx 0 0;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 0;
}

/* 商品列表样式 */
.goods-list {
  border: 2rpx solid var(--border-color);
  border-radius: 0 0 8rpx 8rpx;
  overflow: hidden;
  margin-top: 0;
}

.goods-item {
  display: flex;
  flex-direction: column;
  padding: 15rpx;
  border-bottom: 2rpx solid var(--border-color);
  background-color: #FFFFFF;
  gap: 15rpx;
  box-sizing: border-box;
}

.goods-item:last-child {
  border-bottom: none;
}

/* 商品行布局样式 */
.goods-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  align-items: flex-start;
}

/* 第一行：PN/SN 各50% */
.row-1 {
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pn-field {
  flex: 0.5;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.pn-field.full-width {
  flex: 1;
}

.sn-field {
  flex: 0.5;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.pn-field .code-input,
.sn-field .code-input {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
}

/* 第二行：商品名称（单独一行） */
.row-2 {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: flex-start;
}

.name-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.name-field.full-width {
  flex: 1;
  width: 100%;
}

.name-field .input-name {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
}

.name-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.name-input-row .input-name {
  flex: 1;
  min-width: 0;
}

.btn-search-name {
  flex: 0 0 auto;
  width: 120rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #fff;
  background-color: var(--primary-color);
  border-radius: 8rpx;
}

.btn-search-name::after {
  border: none;
}

/* 第三行：单价和数量 */
.row-3 {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.price-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.price-field .input-number {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
}

.quantity-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.quantity-field .input-number {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
}

/* 第四行：操作按钮 */
.row-4 {
  padding-top: 10rpx;
  display: flex;
  align-items: flex-start;
}

.action-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-field .btn-delete {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  padding: 0;
  margin: 0;
}

/* IMEI行样式 */
.row-imei {
  margin-top: 15rpx;
  background-color: #f0f8ff;
  padding: 15rpx;
  border-radius: 8rpx;
  border: 1rpx dashed #1890ff;
  display: flex;
  gap: 20rpx;
}

.row-imei .goods-field {
  flex: 1;
}

.row-imei .field-label-small {
  color: #1890ff;
  font-weight: bold;
}

.imei-readonly {
  margin: 15rpx 0;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.imei-readonly text {
  font-size: 24rpx;
  color: var(--light-text);
  font-family: monospace;
}

/* 列样式 */
.col {
  display: flex;
  align-items: center;
}

.col-code { flex: 2; flex-direction: column; align-items: flex-start; gap: 10rpx; }
.col-name { flex: 1.5; justify-content: center; }
.col-price { flex: 0.8; justify-content: center; }
.col-quantity { flex: 0.8; justify-content: center; }
.col-action { flex: 0.8; justify-content: center; }

/* 统一输入框样式 */
.input-name,
.code-input,
.input-number,
.input-discount,
.input-text {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 80rpx;
  box-sizing: border-box;
}

.input-name.disabled,
.code-input.disabled,
.input-number.disabled,
.input-discount.disabled {
  background-color: #f0f0f0;
  color: #999;
  border-color: #e0e0e0;
}

/* 商品名称输入框样式 */
.input-name {
  flex: 1;
  max-width: none;
  width: 100%;
}

/* 编码信息样式 */
.code-item {
  display: flex;
  align-items: center;
  width: 100%;
}

.code-label {
  font-size: 24rpx;
  color: var(--light-text);
  width: 80rpx;
}

.code-input {
  flex: 1;
  margin-right: 0;
  width: 100%;
}

/* 扫码按钮样式 */
.code-input-with-scan {
  display: flex;
  align-items: center;
  width: 100%;
}

/* SN 输入框外层还包了一层 picker 容器，必须让它占满剩余宽度，
 * 否则只读详情中的 textarea 会被压缩成一条窄竖线。 */
.inline-picker-input {
  flex: 1;
  min-width: 0;
  width: 100%;
}

.inline-picker-input .code-input,
.inline-picker-input .code-input-textarea {
  width: 100%;
  box-sizing: border-box;
}

.code-display {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 80rpx;
  padding: 15rpx 16rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #075985;
  background: #eff8ff;
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
}

.code-display text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-input-with-scan .code-input {
  border-radius: 6rpx 0 0 6rpx;
  margin: 0;
  flex: 1;
}

.btn-scan-code {
  height: 80rpx;
  padding: 0 20rpx;
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 0 6rpx 6rpx 0;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-width: 120rpx;
}

.btn-scan-code::after {
  border: none;
}

/* 带扫码按钮的字段样式 */
.with-scan {
  flex: 0.5;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.with-scan .code-input-textarea {
  width: 100%;
  flex: none;
}

/* 数字输入框样式 */
.input-number {
  flex: 1;
  max-width: none;
  width: 100%;
  text-align: center;
  min-height: 80rpx;
  box-sizing: border-box;
}

.input-number-small {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  font-size: 28rpx;
  text-align: right;
  box-sizing: border-box;
}

.input-number-small.disabled {
  background-color: #f0f0f0;
  border-color: transparent;
  color: #999;
}

/* 优惠金额输入框样式 */
.input-discount {
  width: 180rpx;
  height: 80rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 0 15rpx;
  text-align: center;
  font-size: 32rpx;
  box-sizing: border-box;
}

.input-discount.small {
  width: 160rpx;
  font-size: 26rpx;
}

.input-discount.disabled {
  background-color: #f0f0f0;
  border-color: transparent;
  color: #999;
  width: 180rpx;
}

.input-discount-textarea {
  width: 180rpx;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 100rpx;
  font-size: 32rpx;
  color: var(--text-color);
  background-color: #f0f0f0;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 15rpx 16rpx;
  line-height: 1.5;
  box-sizing: border-box;
  overflow-y: auto;
  text-align: center;
}

.input-discount-small {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  font-size: 28rpx;
  text-align: right;
  box-sizing: border-box;
}

.input-discount-small.disabled {
  background-color: #f0f0f0;
  border-color: transparent;
  color: #999;
}

/* 商品字段样式 */
.goods-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 金额汇总样式 */
.amount-detail {
  background-color: #F9F9F9;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.amount-item:last-child {
  border-bottom: none;
}

.amount-item.amount-total {
  border-top: 4rpx solid var(--border-color);
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.amount-label {
  font-size: 28rpx;
  color: var(--text-color);
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
}

.amount-value.highlight {
  font-size: 40rpx;
  color: var(--primary-color);
}

.subsidy-inputs {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.btn-query-code {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 0 14rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #07c160;
  background: #f0fff6;
  border: 1rpx solid #b7ebc6;
  border-radius: 8rpx;
}

.btn-query-code::after {
  border: 0;
}

.select-input {
  box-sizing: border-box;
  min-height: 64rpx;
  padding: 14rpx 20rpx;
  color: #333;
  background: #f7f8fa;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
}

.field-actions .btn-query-code,
.field-label-row > .btn-search-name {
  width: 76rpx;
  min-width: 76rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: #07c160;
  border: 0;
  border-radius: 8rpx;
}

.field-actions .btn-scan-code {
  width: 76rpx;
  min-width: 76rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #6b4300;
  background-color: #ffc107;
  border: 0;
  border-radius: 8rpx;
}

.field-actions .btn-list-code {
  width: 76rpx;
  min-width: 76rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: #5b8ff9;
  border: 0;
  border-radius: 8rpx;
}

.field-actions button::after,
.field-label-row > .btn-search-name::after {
  border: 0;
}

.sn-list-modal {
  max-height: 70vh;
}

.sn-list-body {
  max-height: 56vh;
  overflow-y: auto;
}

.sn-list-item {
  min-height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
}

.sn-list-status {
  color: #07c160;
  font-size: 24rpx;
}

.sn-list-empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #999;
}

.deposit-deduction-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.deposit-deduction-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.deposit-deduction-no {
  color: #333;
  font-size: 26rpx;
}

.deposit-deduction-amount {
  color: var(--danger-color);
  font-size: 26rpx;
  font-weight: 600;
}

.deposit-deduction-total {
  color: var(--light-text);
  font-size: 24rpx;
  text-align: right;
}

/* 收款信息样式 */
.payment-list {
  margin-top: 20rpx;
}

.payment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 6rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.payment-info {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.payment-type,
.payment-amount {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.payment-action {
  margin-left: 20rpx;
}

.picker-input-small {
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
}

.picker-input-small.disabled {
  background-color: #f0f0f0;
  border-color: transparent;
  color: #999;
}

/* 收款汇总样式 */
.payment-summary {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-item-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.summary-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.summary-label {
  font-size: 28rpx;
  color: var(--light-text);
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
}

.summary-value.positive {
  color: #52c41a;
}

.summary-value.negative {
  color: #ff4d4f;
}

/* 辅助销售人样式 */
.auxiliary-sales-list {
  margin-top: 20rpx;
}

.auxiliary-sales-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 6rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.auxiliary-sales-info {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.auxiliary-sales-select,
.auxiliary-sales-amount,
.auxiliary-sales-ratio {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.auxiliary-sales-action {
  margin-left: 20rpx;
}

.ratio-text {
  font-size: 26rpx;
  color: #52c41a;
  font-weight: 500;
}

.empty-hint {
  text-align: center;
  padding: 40rpx;
}

.hint-text {
  font-size: 28rpx;
  color: var(--light-text);
}

/* 单选框样式 */
.radio-group {
  display: flex;
  gap: 40rpx;
  margin-top: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.radio-item.disabled {
  opacity: 0.5;
}

.readonly-value {
  padding: 15rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.status-text {
  font-size: 28rpx;
  font-weight: 600;
}

.status-text.status-yes {
  color: #52c41a;
}

.status-text.status-no {
  color: #999;
}

.readonly-text {
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  word-break: break-all;
  margin-top: 10rpx;
}

/* 照片区域样式 */
.photo-section {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 15rpx;
}

.photo-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.photo-wrapper {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f9f9f9;
  position: relative;
}

.photo-preview {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
}

.placeholder-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 10rpx;
}

.photo-wrapper.add {
  border: 4rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: #f9f9f9;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.photo-actions {
  display: flex;
  gap: 10rpx;
  justify-content: center;
}

.btn-photo-action {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  background-color: var(--primary-color);
  color: white;
  border-radius: 6rpx;
  border: none;
  line-height: 1;
}

.btn-photo-action::after {
  border: none;
}

.btn-photo-action.delete {
  background-color: var(--danger-color);
}

.photo-hint {
  display: block;
  text-align: center;
  margin-top: 15rpx;
  font-size: 24rpx;
  color: #ff6b6b;
  line-height: 1.5;
}

/* 多图上传样式 */
.photo-upload-container.multi-photo {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 15rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-item .photo-preview {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.photo-upload-wrapper {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.photo-upload-wrapper.small {
  width: 200rpx;
  height: 200rpx;
}

.photo-upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  width: 100%;
  background-color: #f9f9f9;
}

.photo-upload-icon {
  font-size: 48rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.photo-upload-text {
  font-size: 24rpx;
  color: var(--light-text);
  margin-top: 8rpx;
}

.btn-scan-coupon {
  width: auto;
  min-height: 56rpx;
  height: 56rpx;
  padding: 0 24rpx;
  background-color: #eef8f2;
  color: #13a85b;
  border: 1rpx solid #bde8cf;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  margin: 0;
}

.btn-scan-coupon::after {
  border: none;
}

.education-photo-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
}

.coupon-field {
  margin-top: 24rpx;
}

/* 国补照片上传框样式 */
.photo-upload-wrapper.subsidy-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background-color: #f9f9f9;
}

.photo-upload-wrapper.subsidy-upload.readonly {
  background-color: #f0f0f0;
  border-color: #e0e0e0;
}

.photo-upload-wrapper.subsidy-upload .photo-upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  width: 100%;
  padding: 10rpx;
  box-sizing: border-box;
}

.photo-upload-wrapper.subsidy-upload .photo-upload-text {
  font-size: 22rpx;
  color: var(--light-text);
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

/* 订单备注样式 */
.remark-content {
  padding: 20rpx;
  background-color: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  word-break: break-all;
}

/* 补录记录样式 */
.supplement-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.supplement-item {
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.supplement-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.supplement-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  flex: 1;
}

.supplement-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger-color);
}

.supplement-delete {
  width: 48rpx;
  height: 48rpx;
  background-color: var(--danger-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
}

.delete-icon {
  color: white;
  font-size: 36rpx;
  line-height: 1;
}

.supplement-content-text {
  font-size: 26rpx;
  color: var(--text-color);
  line-height: 1.5;
  margin-bottom: 10rpx;
  padding: 10rpx;
  background-color: #f5f5f5;
  border-radius: 6rpx;
  word-break: break-all;
}

.supplement-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.supplement-photo-img {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

.supplement-total {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 4rpx solid var(--border-color);
  text-align: right;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger-color);
}

/* 归档区域样式 */
.archive-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.archive-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.archive-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.archive-desc {
  font-size: 26rpx;
  color: #999;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 2rpx solid var(--border-color);
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-bar .btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
}

.action-bar .btn::after {
  border: none;
}

.btn-secondary {
  background-color: #f9f9f9;
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
}

.btn-primary.loading {
  opacity: 0.7;
}

.btn-icon {
  font-size: 32rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.goods-select-list {
  max-height: 60vh;
}

.goods-select-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-select-item:active {
  background-color: #f5f5f5;
}

.goods-select-name {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.goods-select-pn {
  font-size: 24rpx;
  color: #999;
}

.goods-select-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 4rpx;
}

.goods-select-price,
.goods-select-stock {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #5f6b76;
  background: #f3f5f6;
}

.goods-select-price {
  color: #c2410c;
  background: #fff7ed;
}

.goods-select-stock.has-stock {
  color: #087443;
  background: #eaf8f0;
}

.goods-select-more {
  padding: 22rpx 0;
  color: var(--primary-color);
  font-size: 26rpx;
  text-align: center;
}

.modal-text {
  font-size: 30rpx;
  color: var(--text-color);
  text-align: center;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid var(--border-color);
}

.modal-footer .btn {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-footer .btn::after {
  border: none;
}

.return-card .section-hint {
  flex: 1;
  margin-left: 16rpx;
}

.btn-return {
  width: 100%;
  color: #fff;
  background: #e24b4b;
}

.return-modal {
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.return-modal-scroll {
  height: 60vh;
  min-height: 0;
  flex: 1;
}

.return-modal .modal-body {
  padding: 28rpx 30rpx;
}

.return-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.return-item.disabled {
  opacity: .5;
}

.return-subsidy-choice {
  margin: 20rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 12rpx;
  background: #eff6ff;
}

.return-subsidy-title,
.return-subsidy-hint,
.return-subsidy-option {
  display: block;
}

.return-subsidy-title {
  color: #1e3a8a;
  font-size: 28rpx;
  font-weight: 600;
}

.return-subsidy-hint {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.5;
}

.return-subsidy-option {
  margin-top: 14rpx;
  color: #1f2937;
  font-size: 25rpx;
}

.return-item-main {
  flex: 1;
}

.return-item-name,
.return-item-meta,
.return-quantity-row {
  display: block;
  line-height: 1.6;
}

.return-item-meta {
  color: #888;
  font-size: 24rpx;
}

.return-quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}

.return-quantity-input {
  width: 110rpx;
  padding: 6rpx 10rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
}

.return-total {
  margin: 20rpx 0;
  color: #d4380d;
  font-size: 32rpx;
  font-weight: 600;
}

.return-breakdown {
  margin: 8rpx 0;
  color: #666;
  font-size: 24rpx;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: 10rpx;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .goods-header {
    font-size: 24rpx;
  }

  .payment-item,
  .auxiliary-sales-item {
    flex-wrap: wrap;
  }

  .payment-info,
  .auxiliary-sales-info {
    flex-wrap: wrap;
  }

  .payment-type,
  .payment-amount,
  .auxiliary-sales-select,
  .auxiliary-sales-amount {
    width: calc(50% - 10rpx);
  }

  .payment-action,
  .auxiliary-sales-action {
    width: 100%;
    text-align: right;
