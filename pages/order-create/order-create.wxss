}

.form-field {
  gap: 14rpx;
}

.field-label,
.field-label-small {
  color: #8b949e;
  font-size: 24rpx;
  line-height: 1.3;
}

.field-input,
.picker-input,
.field-textarea,
.input-name,
.code-input,
.input-number,
.input-discount,
.input-text,
.input-number-small,
.input-discount-small,
.picker-input-small,
.sn-picker-input,
.pn-picker-input {
  border: none;
  border-bottom: 1rpx solid #edf0f2;
  border-radius: 0;
  background-color: #fff;
  padding: 0;
  min-height: 66rpx;
  font-size: 29rpx;
  color: #111827;
}

.picker-input,
.picker-input-small,
.sn-picker-input,
.pn-picker-input {
  padding-right: 8rpx;
}

.field-textarea {
  padding: 12rpx 0;
  min-height: 132rpx;
}

.btn-add {
  margin: 0;
  padding: 0;
  background-color: transparent;
  color: #13a85b;
  font-size: 25rpx;
  line-height: 1.4;
}

/* 商品信息标题行的操作按钮始终贴齐卡片最右侧 */
.section-header .btn-add {
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
}

.goods-header {
  display: none;
}

.goods-list {
  border: none;
  border-radius: 0;
}

.goods-item {
  padding: 0 0 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #edf0f2;
  gap: 22rpx;
}

.goods-item:last-child {
  padding-bottom: 0;
}

.goods-row {
  gap: 24rpx;
}

.row-1,
.row-2,
.row-3 {
  padding: 0;
  border-bottom: none;
}

.row-4 {
  padding-top: 0;
  justify-content: flex-end;
}

.action-field {
  align-items: flex-end;
}

.btn-delete,
.btn-delete-small {
  width: auto;
  min-height: 48rpx;
  height: 48rpx;
  padding: 0 20rpx;
  background-color: #fff;
  color: #d64545;
  border: 1rpx solid #f0b8b8;
  border-radius: 8rpx;
  font-size: 23rpx;
}

.code-input-with-scan {
  align-items: stretch;
}

.code-input-with-scan .code-input,
.pn-picker-input {
  border-bottom-right-radius: 0;
}

.btn-scan-code {
  height: 66rpx;
  min-width: 92rpx;
  padding: 0 16rpx;
  background-color: #eef8f2;
  color: #13a85b;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.row-imei {
  margin-top: 0;
  padding: 18rpx;
  background-color: #f4f8fb;
  border: 1rpx solid #dbe8f2;
  border-radius: 12rpx;
}

.amount-detail {
  border: none;
  background-color: #fff;
  padding: 0;
  gap: 0;
}

.amount-item {
  min-height: 78rpx;
  padding: 0;
  border-bottom: 1rpx solid #edf0f2;
}

.amount-item.amount-total {
  border-top: none;
  margin-top: 0;
  padding-top: 0;
  min-height: 96rpx;
}

.amount-label {
  font-size: 27rpx;
  color: #374151;
}

.amount-value {
  font-size: 30rpx;
  color: #111827;
}

.amount-value.highlight {
  font-size: 36rpx;
  color: #d32f2f;
}

.subsidy-inputs {
  justify-content: flex-end;
  max-width: 440rpx;
  gap: 12rpx;
}

.input-discount,
.input-discount.small {
  width: 128rpx;
  height: 66rpx;
  font-size: 25rpx;
  text-align: right;
}

.payment-list,
.auxiliary-sales-list {
  margin-top: 0;
}

.payment-item,
.auxiliary-sales-item {
  padding: 20rpx 0;
  border-radius: 0;
  margin-bottom: 0;
  box-shadow: none;
  border-bottom: 1rpx solid #edf0f2;
}

.payment-info,
.auxiliary-sales-info {
  gap: 24rpx;
}

.payment-summary {
  margin-top: 24rpx;
  padding: 24rpx 0 0;
  box-shadow: none;
  border-radius: 0;
  border-top: 1rpx solid #edf0f2;
}

.summary-label {
  font-size: 24rpx;
}

.summary-value {
  font-size: 28rpx;
}

.radio-group {
  gap: 18rpx;
  flex-wrap: wrap;
  margin-top: 0;
}

.radio-item {
  min-width: 128rpx;
  height: 58rpx;
  padding: 0 22rpx;
  justify-content: center;
  border: 1rpx solid #d8dee4;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.subsidy-person-section,
.photo-section {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #edf0f2;
}

.section-subtitle {
  font-size: 27rpx;
}

.subsidy-person-warning {
  margin-left: 16rpx;
  color: #e64340;
  font-size: 24rpx;
}

.photo-upload-container.multi-photo,
.photo-list {
  gap: 20rpx;
}

.photo-item,
.photo-upload-wrapper,
.photo-upload-wrapper.small {
  width: 196rpx;
  height: 196rpx;
}

.photo-upload-wrapper {
  border-color: #e5e7eb;
  border-radius: 8rpx;
  background-color: #fafafa;
}

.photo-upload-placeholder {
  background-color: #fafafa;
}

.photo-upload-icon {
  color: #333;
  font-size: 44rpx;
  font-weight: 400;
}

.photo-upload-text {
  color: #4b5563;
  font-size: 23rpx;
}

.photo-hint {
  text-align: left;
  color: #8b949e;
}

.empty-hint {
  padding: 42rpx 0;
}

.hint-text {
  color: #9ca3af;
}

.action-bar {
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0f2;
  box-shadow: 0 -10rpx 30rpx rgba(31, 48, 64, 0.08);
}

.action-bar .btn {
  height: 88rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.action-bar .btn-secondary {
  flex: 0.78;
  background-color: #f3f4f6;
  color: #374151;
  border: none;
}

.action-bar .btn-primary {
  flex: 1.45;
  background-color: #12a85a;
  color: #fff;
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.48);
  box-sizing: border-box;
}

.privacy-dialog {
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2933;
  text-align: center;
}

.privacy-content {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5f6b76;
}

.privacy-link {
  color: #07c160;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.privacy-btn::after {
  border: 0;
}

.privacy-btn.secondary {
  color: #5f6b76;
  background: #f3f5f6;
}

.privacy-btn.primary {
  color: #ffffff;
  background: #07c160;
}

/* 文本输入与下拉选择共用同一个控件，避免再占用一行显示候选列表。 */
.inline-picker-input {
  border: none;
  border-bottom: 1rpx solid #edf0f2;
  border-radius: 0;
  background-color: #fff;
}

.inline-picker-input .code-input,
.inline-picker-input .input-number-small {
  border: none;
}

.form-item {
  margin-top: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.btn-secondary-small {
  margin: 16rpx 0 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #1677ff;
  background: #eef5ff;
  border-radius: 8rpx;
}

.btn-secondary-small::after {
  border: 0;
}
