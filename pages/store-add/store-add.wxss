/* 门店新增页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.header {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 表单样式 */
.store-form {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

/* 表单区块 */
.form-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  border-left: 6rpx solid #1AAD19;
  padding-left: 15rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 25rpx;
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 80rpx;
  box-sizing: border-box;
}

.form-textarea {
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 120rpx;
  box-sizing: border-box;
  resize: none;
}

/* 员工信息 */
.staff-list {
  margin-top: 20rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.staff-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
  flex-wrap: wrap;
}

.staff-item .form-input {
  flex: 1;
  min-width: 200rpx;
  min-height: 80rpx;
}

.btn-delete {
  margin: 0;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

.btn-add {
  margin: 15rpx 0;
  font-size: 26rpx;
  padding: 12rpx;
  width: 100%;
}

/* 表单操作按钮 */
.form-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  padding: 15rpx;
  margin: 0;
}

.btn-primary {
  background-color: #1AAD19;
  color: white;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
}