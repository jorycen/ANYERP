.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f5f7fa; }
.tabs { display: flex; white-space: nowrap; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 24rpx; box-sizing: border-box; }
.tab { display: inline-block; width: 25%; padding: 20rpx 8rpx; text-align: center; color: #666; border-radius: 12rpx; box-sizing: border-box; }
.tab.active { color: #fff; background: #1aad19; font-weight: 600; }
.card, .application-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.section-head, .item-head, .application-head, .application-foot, .switch-row, .total-row { display: flex; justify-content: space-between; align-items: center; }
.section-head-actions { display: flex; align-items: center; gap: 20rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 600; color: #222; margin-bottom: 24rpx; }
.section-title.no-margin { margin-bottom: 0; }
.link { color: #1aad19; font-size: 25rpx; }
.used-product-link, .used-product-badge { color: #e67e22; }
.field-label { display: block; color: #555; font-size: 26rpx; margin: 18rpx 0 10rpx; }
.field-label.required::before { content: '*'; color: #e53935; margin-right: 5rpx; }
.field-tip { display: block; margin-top: 10rpx; color: #7a838d; font-size: 23rpx; line-height: 1.5; }
.input, .textarea, .picker-value { width: 100%; box-sizing: border-box; border: 2rpx solid #e4e7ed; border-radius: 10rpx; padding: 20rpx; background: #fafafa; font-size: 27rpx; color: #222; }
.input, .picker-value { height: 82rpx; min-height: 82rpx; padding: 0 20rpx; line-height: 82rpx; }
.input { margin-bottom: 12rpx; }
.textarea { height: 150rpx; padding: 20rpx; line-height: 1.5; }
.placeholder { color: #a8abb2; }
.search-row, .two-columns { display: flex; gap: 16rpx; }
.search-input { flex: 1; min-width: 0; }
.small-btn { width: 140rpx; height: 82rpx; line-height: 82rpx; margin: 0; padding: 0; color: #fff; background: #1aad19; font-size: 26rpx; }
.two-columns { margin-top: 8rpx; }
.column { flex: 1; min-width: 0; }
.product-search { margin-top: 24rpx; }
.search-results { max-height: 460rpx; overflow-y: auto; border: 2rpx solid #e8eaed; border-radius: 12rpx; margin-bottom: 24rpx; }
.search-result { display: flex; align-items: center; padding: 20rpx; border-bottom: 1rpx solid #eee; }
.search-result:last-child { border-bottom: 0; }
.result-info { flex: 1; min-width: 0; }
.product-name { display: block; color: #222; font-size: 28rpx; font-weight: 600; }
.muted { display: block; color: #909399; font-size: 23rpx; margin-top: 7rpx; }
.add-btn { flex-shrink: 0; margin-left: 12rpx; color: #1aad19; background: #f0faf0; border-color: #1aad19; }
.purchase-item { padding: 22rpx; margin-top: 18rpx; background: #f8fafb; border: 2rpx solid #e6e9ed; border-radius: 12rpx; }
.remove { color: #e53935; font-size: 25rpx; }
.compact .field-label { margin-top: 18rpx; }
.resource-options { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; padding: 18rpx; border: 2rpx solid #e4e7ed; border-radius: 10rpx; background: #fff; }
.resource-option { display: flex; align-items: center; color: #555; font-size: 24rpx; }
.resource-option checkbox { transform: scale(.8); margin-right: 2rpx; }
.item-subtotal { color: #e67e22; text-align: right; font-size: 26rpx; margin-top: 14rpx; }
.total-row { padding: 28rpx 4rpx 10rpx; color: #555; }
.total-amount, .amount { color: #e67e22; font-size: 34rpx; font-weight: 600; }
.submit-btn { margin-top: 22rpx; color: #fff; background: #1aad19; }
.workflow-tip { display: block; text-align: center; color: #909399; font-size: 23rpx; margin-top: 15rpx; }
.application-head { margin-bottom: 16rpx; }
.request-no { color: #333; font-size: 28rpx; font-weight: 600; }
.status { font-size: 24rpx; color: #e69500; }
.status-approved, .status-purchased { color: #1aad19; }
.status-rejected { color: #d93025; }
.status-revoked { color: #909399; }
.summary { line-height: 1.5; margin-bottom: 12rpx; }
.application-foot { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #eee; }
.application-foot .muted { margin-top: 0; }
.workflow-list-card { padding-bottom: 20rpx; }
.list-caption { display: block; margin-top: 8rpx; color: #909399; font-size: 23rpx; }
.record-filters { display: flex; white-space: nowrap; margin: 24rpx -8rpx 16rpx; }
.record-filter { display: inline-block; padding: 12rpx 22rpx; margin: 0 8rpx; border-radius: 30rpx; color: #606266; background: #f2f4f7; font-size: 24rpx; }
.record-filter.active { color: #fff; background: #1aad19; }
.workflow-record { padding: 22rpx 0; border-top: 1rpx solid #edf0f2; }
.record-topline { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.record-topline .request-no { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-type { flex-shrink: 0; padding: 6rpx 12rpx; border-radius: 8rpx; color: #fff; font-size: 22rpx; }
.record-type-purchase { background: #409eff; }
.record-type-product { background: #9b59b6; }
.record-type-expense { background: #e67e22; }
.stage-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 10rpx; background: #f7faf8; }
.stage-label { color: #6b7280; font-size: 24rpx; }
.stage-value { color: #1aad19; font-size: 26rpx; font-weight: 600; }
.record-action-row { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; margin-top: 14rpx; }
.revoke-disabled { flex: 1; color: #a0a6ad; font-size: 23rpx; }
.revoke-btn { margin: 0; padding: 0 22rpx; border: 1rpx solid #e5484d; border-radius: 8rpx; color: #d93025; background: #fff5f5; font-size: 24rpx; line-height: 58rpx; }
.record-pagination { display: flex; align-items: center; justify-content: center; gap: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f2; }
.page-btn { min-width: 136rpx; margin: 0; color: #1aad19; background: #f0faf0; font-size: 24rpx; }
.page-number { color: #606266; font-size: 24rpx; }
.dynamic-fields { margin-top: 24rpx; padding: 20rpx; border-radius: 12rpx; background: #f5f7fa; }
.group-title { display: block; color: #333; font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.name-preview { padding: 22rpx; margin: 22rpx 0; border-left: 8rpx solid #1aad19; background: #f0faf0; }
.preview-label { display: block; color: #777; font-size: 23rpx; margin-bottom: 8rpx; }
.preview-name { color: #222; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.switch-row { padding: 20rpx 4rpx; border-bottom: 1rpx solid #eee; color: #555; font-size: 27rpx; }
.application-list { margin-top: 40rpx; padding-top: 28rpx; border-top: 2rpx solid #eee; }
.application-title { margin-bottom: 18rpx; }
.product-application { padding: 20rpx; margin-bottom: 16rpx; border: 2rpx solid #e8eaed; border-radius: 12rpx; background: #fafafa; }
.review-info { display: block; color: #606266; font-size: 23rpx; margin-top: 10rpx; }
.detail-btn { display: inline-block; margin: 14rpx 0 0; padding: 0 22rpx; border: 1rpx solid #b7c9e8; border-radius: 8rpx; color: #3568a8; background: #f4f8ff; font-size: 24rpx; line-height: 58rpx; }
.approved-tip { display: block; color: #1aad19; font-size: 24rpx; margin-top: 12rpx; }
.loading, .empty { padding: 100rpx 20rpx; text-align: center; color: #909399; }
.small-empty { padding: 50rpx 20rpx; }
.allocation-list { padding: 8rpx 0; }
.allocation-row { padding: 16rpx; margin: 12rpx 0; border: 2rpx solid #e4e7ed; border-radius: 10rpx; background: #fff; }
.allocation-row:first-child { margin-top: 0; }
.allocation-quantity-column { max-width: 220rpx; }
.allocation-row-footer { display: flex; align-items: center; justify-content: space-between; }
.allocation-total-tip { color: #1aad19; }
.allocation-add-btn { width: 240rpx; height: 64rpx; margin: 12rpx 0 8rpx; line-height: 64rpx; color: #1aad19; border: 1rpx solid #1aad19; background: #f0faf0; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.photo-item,
.photo-add { position: relative; width: 190rpx; height: 190rpx; box-sizing: border-box; }
.photo-thumb { width: 100%; height: 100%; border-radius: 10rpx; background: #f2f4f7; }
.photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #cfd6dd; border-radius: 10rpx; color: #7a838d; font-size: 24rpx; background: #fafbfc; }
.photo-add-icon { font-size: 52rpx; line-height: 1; color: #1aad19; margin-bottom: 8rpx; }
.photo-remove { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; border-radius: 50%; color: #fff; background: #e53935; font-size: 30rpx; line-height: 36rpx; text-align: center; z-index: 1; }

.modal-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, .42); }
.selection-modal { width: 100%; max-height: 82vh; box-sizing: border-box; padding: 30rpx 28rpx 28rpx; border-radius: 28rpx 28rpx 0 0; background: #fff; }
.modal-header { display: flex; align-items: center; justify-content: space-between; }
.modal-title { color: #222; font-size: 34rpx; font-weight: 600; }
.modal-close { color: #777; font-size: 52rpx; line-height: 1; }
.modal-search-row { margin-top: 18rpx; }
.modal-results-title { margin: 22rpx 0 12rpx; padding-left: 16rpx; border-left: 8rpx solid #1aad19; color: #444; font-size: 27rpx; }
.modal-selection-list { height: 48vh; max-height: 48vh; box-sizing: border-box; border: 1rpx solid #edf0f2; border-radius: 14rpx; }
.selection-item { display: flex; align-items: center; padding: 22rpx 18rpx; border-bottom: 1rpx solid #eee; }
.selection-item:last-child { border-bottom: 0; }
.selection-item:active .select-dot { border-color: #1aad19; background: #1aad19; color: #fff; }
.select-dot { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 18rpx; border: 2rpx solid #b9c0c4; border-radius: 50%; color: transparent; font-size: 25rpx; }
.select-label { flex-shrink: 0; margin-left: 12rpx; color: #1aad19; font-size: 25rpx; }
.modal-empty { padding: 70rpx 0; color: #999; font-size: 26rpx; text-align: center; }
.modal-cancel { height: 76rpx; margin: 22rpx 0 0; border-radius: 14rpx; background: #f0f2f3; color: #555; font-size: 28rpx; line-height: 76rpx; }
