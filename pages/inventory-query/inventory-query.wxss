.page {
  min-height: 100vh;
  background: #f5f7f8;
  padding-bottom: env(safe-area-inset-bottom);
}

.search-panel {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 24rpx;
  background: #1aad19;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #1f2933;
  box-sizing: border-box;
}

.search-button {
  width: 132rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #0f8f24;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.search-button::after {
  border: 0;
}

.store-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.store-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ffffff;
}

.picker-arrow {
  font-size: 20rpx;
}

.result-count {
  color: #ffffff;
}

.quick-filter-panel {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.14);
}

.quick-filter-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.quick-filter-row + .quick-filter-row {
  margin-top: 12rpx;
}

.quick-filter-label {
  flex: 0 0 96rpx;
  padding-top: 10rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  font-weight: 600;
}

.quick-filter-buttons {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quick-filter-button {
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  background: transparent;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 54rpx;
}

.quick-filter-button::after {
  border: 0;
}

.quick-filter-button.active {
  border-color: #ffffff;
  background: #ffffff;
  color: #0f8f24;
}

.quick-filter-button[disabled] {
  opacity: 0.45;
}

.result-list {
  height: calc(100vh - 152rpx);
  box-sizing: border-box;
}

.special-table-wrapper {
  margin: 20rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(31, 48, 64, 0.06);
}

.special-table-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 700;
}

.special-table {
  width: 100%;
  border-top: 1rpx solid #e5e7eb;
  border-left: 1rpx solid #e5e7eb;
}

.special-table-row {
  display: block;
  border-bottom: 1rpx solid #e5e7eb;
}

.special-table-header {
  background: #f8fafc;
  color: #475569;
  font-weight: 700;
}

.special-table-info-line,
.special-table-detail-line {
  display: flex;
  align-items: stretch;
  width: 100%;
}

.special-table-detail-line {
  border-top: 1rpx solid #f1f5f9;
}

.special-row-white {
  background: #ffffff;
}

.special-row-blue {
  background: #f0f7ff;
}

.special-col {
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #e5e7eb;
  color: #374151;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.pn-col {
  flex: 0 0 20%;
}

.sn-col {
  flex: 0 0 23%;
}

.name-col {
  flex: 0 0 35%;
  min-width: 0;
}

.price-col {
  flex: 0 0 43%;
}

.info-detail-col {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
}

.special-price-cell {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.special-price {
  color: #c2410c;
  font-weight: 700;
}

.unified-price {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 21rpx;
}

.special-empty {
  padding: 60rpx 0 30rpx;
}

.model-continue-query {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 24rpx 24rpx 40rpx;
  color: #64748b;
  font-size: 23rpx;
}

.model-query-complete {
  color: #16a34a;
}

.category-section {
  padding: 20rpx 24rpx 0;
}

.category-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2933;
}

.category-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #8b949e;
}

.inventory-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(31, 48, 64, 0.06);
}

.inventory-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #1f2933;
  line-height: 1.45;
}

.product-status {
  color: #d48806;
  font-size: 24rpx;
}

.product-spec,
.product-pn,
.product-sn {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.pn-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.product-pn {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.sales-row,
.stock-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.price,
.stock-summary {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.price {
  white-space: nowrap;
}

.standard-price {
  color: #475569;
  background: #f1f5f9;
}

.sale-price {
  color: #c2410c;
  background: #fff7ed;
}

.sales-row text {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  color: #2563eb;
  background: #eff6ff;
}

.stock-summary {
  color: #6b7280;
  background: #f1f3f5;
}

.other-stock-wrapper {
  position: relative;
}

.other-stock {
  color: #7c3aed;
  background: #f3e8ff;
}

.other-store-popover {
  display: none;
  position: absolute;
  left: 0;
  top: 52rpx;
  z-index: 5;
  min-width: 240rpx;
  max-width: 460rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 48, 64, 0.16);
  border: 1rpx solid #e5e7eb;
}

.other-stock-wrapper:hover .other-store-popover,
.other-store-popover.visible {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.other-store-line {
  font-size: 23rpx;
  line-height: 1.4;
  color: #374151;
  white-space: nowrap;
}

.store-stock {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0f2;
  font-size: 23rpx;
  line-height: 1.4;
}

.product-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.product-orders-button,
.product-sns-button {
  display: block;
  width: 180rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #1aad19;
  border-radius: 8rpx;
  background: #f0fdf4;
  color: #15803d;
  font-size: 23rpx;
  line-height: 54rpx;
}

.product-orders-button::after {
  border: 0;
}

.product-sns-button {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}

.product-sns-button::after {
  border: 0;
}

.order-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.order-dialog {
  width: 100%;
  max-height: 78vh;
  padding: 26rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.sn-dialog {
  width: 100%;
  max-height: 82vh;
  padding: 26rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.order-dialog-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-dialog-title,
.order-dialog-product {
  display: block;
}

.order-dialog-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
}

.order-dialog-product {
  max-width: 560rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-dialog-close {
  color: #9ca3af;
  font-size: 44rpx;
  line-height: 36rpx;
}

.order-dialog-tip {
  margin-top: 18rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #f0fdf4;
  color: #15803d;
  font-size: 22rpx;
}

.order-dialog-list {
  height: 52vh;
  max-height: 52vh;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sn-dialog-list {
  height: 58vh;
  max-height: 58vh;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sn-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.sn-row:last-child {
  border-bottom: 0;
}

.sn-row-head,
.sn-row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.sn-row-line {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.sn-code {
  color: #1f2933;
  font-size: 26rpx;
  font-weight: 700;
}

.sn-store {
  max-width: 260rpx;
  overflow: hidden;
  color: #2563eb;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sn-age {
  color: #c2410c;
  font-weight: 600;
}

.sn-row-location {
  color: #9ca3af;
}

.order-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.order-row:last-child {
  border-bottom: 0;
}

.order-row-head,
.order-row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.order-row-line {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.order-no {
  color: #1f2933;
  font-size: 25rpx;
  font-weight: 600;
}

.order-time {
  color: #9ca3af;
  font-size: 21rpx;
}

.order-profit {
  color: #c2410c;
  font-weight: 600;
}

.order-dialog-loading,
.order-dialog-empty {
  padding: 70rpx 0 40rpx;
  text-align: center;
  color: #8b949e;
  font-size: 25rpx;
}

.store-chip {
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
}

.store-chip.current {
  color: #087443;
  background: #eaf8f0;
}

.store-chip.other {
  color: #7c3aed;
  background: #f3e8ff;
}

.empty,
.loading {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b949e;
}
