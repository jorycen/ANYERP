/* 经销商信息管理页面样式 */
.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background-color: var(--background-color);
}

/* 页面头部 */
.header {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-align: center;
}

/* 通用区块样式 */
.info-section,
.staff-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 30rpx;
  display: block;
}

/* 经销商基本信息样式 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.info-value {
  font-size: 32rpx;
  color: var(--text-color);
  font-weight: bold;
}

/* 员工管理样式 */
.btn-add {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  background-color: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
  min-height: auto;
  line-height: normal;
  margin: 0;
}

/* 员工列表样式 */
.staff-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.staff-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background-color: #F9F9F9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.staff-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-right: 20rpx;
}

.staff-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.staff-position {
  font-size: 28rpx;
  color: var(--light-text);
}

.staff-phone {
  font-size: 28rpx;
  color: var(--primary-color);
}

.staff-actions {
  display: flex;
  gap: 10rpx;
}

.btn-edit {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: 6rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  min-height: auto;
  line-height: 50rpx;
}

.btn-delete {
  background-color: var(--danger-color);
  color: #FFFFFF;
  border: none;
  border-radius: 6rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  min-height: auto;
  line-height: 50rpx;
}

/* 空列表样式 */
.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--light-text);
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.btn-add-first {
  font-size: 28rpx;
  padding: 15rpx 40rpx;
  background-color: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  width: 80%;
  max-width: 500rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.modal-close {
  font-size: 48rpx;
  color: var(--light-text);
  cursor: pointer;
}

.modal-body {
  padding: 30rpx;
}

/* 表单样式 */
.staff-form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--light-text);
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  font-size: 32rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn {
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
  min-height: auto;
  line-height: normal;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: 10rpx;
  }
  
  .info-grid {
    grid-template-columns: 1fr;
  }
  
  .staff-item {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .staff-actions {
    margin-top: 20rpx;
  }
  
  .modal-content {
    width: 95%;
  }
}