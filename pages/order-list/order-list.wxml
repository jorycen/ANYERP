<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">订单查询</text>
    <view class="header-actions">
      <button class="btn-export" type="default" bindtap="exportOrders">导出订单</button>
      <button class="btn-tasks" type="default" bindtap="showMyExportTasks">我的任务</button>
    </view>
  </view>
  
  <!-- 查询表单 -->
  <view class="search-section">
    <form class="search-form">
      <!-- 第一行：订单编号、提交人 -->
      <view class="search-row">
        <view class="search-item">
          <text class="search-label">订单编号</text>
          <input class="search-input" type="text" placeholder="请输入订单编号" bindinput="onOrderNoInput" value="{{searchOrderNo}}" />
        </view>
        <view class="search-item">
          <text class="search-label">提交人</text>
          <picker mode="selector" bindchange="onSubmitterChange" range="{{submitterOptions}}" value="{{submitterIndex}}">
            <view class="picker-input">
              {{submitterOptions[submitterIndex] || '全部'}}
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 第二行：PN、SN -->
      <view class="search-row">
        <view class="search-item">
          <text class="search-label">PN</text>
          <input class="search-input" type="text" placeholder="请输入PN码查询" bindinput="onPnInput" value="{{searchPn}}" />
        </view>
        <view class="search-item">
          <text class="search-label">SN</text>
          <input class="search-input" type="text" placeholder="请输入SN码查询" bindinput="onSnInput" value="{{searchSn}}" />
        </view>
      </view>
      
      <!-- 第三行：开票信息、归档状态 -->
      <view class="search-row">
        <view class="search-item">
          <text class="search-label">开票信息</text>
          <input class="search-input" type="text" placeholder="请输入国补人或开票信息" bindinput="onInvoiceInfoInput" value="{{searchInvoiceInfo}}" />
        </view>
        <view class="search-item">
          <text class="search-label">归档状态</text>
          <picker mode="selector" range="{{statusOptions}}" bindchange="onStatusChange" value="{{statusIndex}}">
            <view class="picker-input">
              {{statusOptions[statusIndex]}}
            </view>
          </picker>
        </view>
      </view>

      <view class="search-row">
        <view class="search-item">
          <text class="search-label">资源类型</text>
          <picker mode="selector" range="{{resourceTypeOptions}}" range-key="label" bindchange="onResourceTypeChange" value="{{resourceTypeIndex}}">
            <view class="picker-input">{{resourceTypeOptions[resourceTypeIndex].label || resourceTypeOptions[resourceTypeIndex] || '全部'}}</view>
          </picker>
        </view>
      </view>

      <!-- 第四行：开始时间、结束时间 -->
      <view class="search-row">
        <view class="search-item">
          <text class="search-label">开始时间</text>
          <picker mode="date" bindchange="onStartDateChange" value="{{startDate}}" start="2020-01-01" end="{{currentDate}}" disabled="{{isTimeDisabled}}">
            <view class="picker-input {{isTimeDisabled ? 'disabled' : ''}}">
              {{startDate || '请选择开始日期'}}
            </view>
          </picker>
        </view>
        <view class="search-item">
          <text class="search-label">结束时间</text>
          <picker mode="date" bindchange="onEndDateChange" value="{{endDate}}" start="2020-01-01" end="{{currentDate}}" disabled="{{isTimeDisabled}}">
            <view class="picker-input {{isTimeDisabled ? 'disabled' : ''}}">
              {{endDate || '请选择结束日期'}}
            </view>
          </picker>
        </view>
      </view>
      
      <view class="search-actions">
        <button class="btn btn-primary" type="primary" bindtap="searchOrders">查询</button>
        <button class="btn btn-all" type="default" bindtap="searchAllOrders">查询全部</button>
        <button class="btn btn-secondary" type="default" bindtap="resetSearch">重置</button>
      </view>
    </form>
  </view>
  
  <!-- 订单列表 -->
  <view class="order-list-section">
    <view class="section-header">
      <text class="section-title">订单列表</text>
      <text class="section-count">{{filteredOrders.length}} 条记录</text>
    </view>

    <!-- 加载中提示 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 订单列表内容 -->
    <view class="order-list">
      <block wx:if="{{filteredOrders.length > 0}}">
        <view class="order-item" wx:for="{{filteredOrders}}" wx:key="orderNo">
          <view class="order-header">
            <text class="order-no">{{item.orderNo}}</text>
            <view class="order-status-group">
              <text class="order-status" wx:if="{{item.status === '已归档'}}" style="background-color: var(--success-color);">已归档</text>
              <text class="order-status" wx:elif="{{item.status === '已作废'}}" style="background-color: #FF4D4F;">已作废</text>
              <text class="order-status" wx:elif="{{item.status === 'returned' || item.status === '退单' || item.status === '已退单'}}" style="background-color: #722ED1;">已退单</text>
              <text class="order-status" wx:elif="{{item.status === 'return_inbound' || item.status === '退库处理中' || item.status === '退货入库中'}}" style="background-color: #1677FF;">退货入库中</text>
              <text class="order-status" wx:elif="{{item.status === 'return_pending' || item.status === 'returning' || item.status === '已发起退单申请' || item.status === '退单审批中'}}" style="background-color: #FA8C16;">退单审批中</text>
              <text class="order-status" wx:elif="{{item.status === 'pending_approval'}}" style="background-color: var(--warning-color);">待审批</text>
              <text class="order-status" wx:else style="background-color: var(--warning-color);">未归档</text>
              <text class="order-status report-status" wx:if="{{item.reportToMall && item.reportToMall.status === 'reported'}}">已上报商场</text>
            </view>
          </view>
          
          <view class="order-info" bindtap="viewOrderDetail" data-orderno="{{item.orderNo}}">
            <view class="info-item">
              <text class="info-label">下单时间:</text>
              <text class="info-value">{{item.createTimeFormat}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">提交人:</text>
              <text class="info-value">{{item.createUser}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">商品数量:</text>
              <text class="info-value">{{item.goods.length}} 件</text>
            </view>
            <!-- 商品信息 -->
            <view class="info-item goods-info">
              <text class="info-label">商品信息:</text>
              <view class="goods-list">
                <block wx:for="{{item.goods}}" wx:key="index" wx:if="{{index < 2}}">
                  <view class="goods-item">
                    <text class="goods-name">{{item.name}}: ¥{{item.price}} × {{item.quantity}}</text>
                    <view class="goods-code-row">
                      <text class="goods-code goods-code-pn"><text class="goods-code-label">PN</text>{{item.pnCode || '无'}}</text>
                      <text class="goods-code goods-code-sn"><text class="goods-code-label">SN</text>{{item.snCode || '无'}}</text>
                    </view>
                  </view>
                </block>
                <text class="goods-more" wx:if="{{item.goods.length > 2}}">...等{{item.goods.length}}件商品</text>
              </view>
            </view>
            
            <!-- 应收金额和实付金额 -->
            <view class="info-item amount-row">
              <view class="amount-item">
                <text class="info-label">应收金额:</text>
                <text class="info-value amount-receivable">¥{{item.actualAmount}}</text>
              </view>
              <view class="amount-item">
                <text class="info-label">实付金额:</text>
                <text class="info-value amount-paid">¥{{item.paymentTotal}}</text>
              </view>
            </view>
            
            <view class="info-item" wx:if="{{item.auxiliarySalesList && item.auxiliarySalesList.length > 0}}">
              <text class="info-label">辅助销售人:</text>
              <text class="info-value">{{item.auxiliarySalesList.length}} 人</text>
            </view>
          </view>
          
          <!-- 操作按钮 -->
          <view class="order-summary-row">
            <view class="gross-profit-summary gross-profit-{{item.grossProfitTone}}" bindtap="showGrossProfitDetail" data-order="{{item}}">
              <text class="summary-label">毛利预估:</text>
              <text class="summary-value gross-profit-{{item.grossProfitTone}}">{{item.grossProfitText}}</text>
            </view>
            <button class="action-btn resource-btn" bindtap="showAvailableResources" data-order="{{item}}">可用资源</button>
          </view>
          <view class="order-actions" wx:if="{{item.status !== '已作废' && item.canOperate}}">
            <button
              class="action-btn remark-btn"
              bindtap="showRemarkModal"
              data-order="{{item}}"
            >
              {{item.remark ? '修改备注' : '添加备注'}}
            </button>
            <button
              class="action-btn supplement-btn"
              bindtap="showSupplementModal"
              data-order="{{item}}"
              wx:if="{{item.status === '未归档' || item.status === '已归档'}}"
            >
              {{item.supplements && item.supplements.length > 0 ? '修改补录金额' : '金额补录'}}
            </button>
            <button
              class="action-btn archive-btn"
              bindtap="archiveOrder"
              data-orderno="{{item.orderNo}}"
              data-order="{{item}}"
              wx:if="{{item.record_type !== 'deposit' && item.recordType !== 'deposit' && item.status !== 'deposit_receipt' && item.status !== '已归档' && item.status !== 'pending_approval' && !item.isReturnFlowStatus}}"
            >
              归档
            </button>
            <button
              class="action-btn return-status-btn"
              disabled="true"
              wx:if="{{item.isReturnFlowStatus}}"
            >
              {{item.orderStatusLabel}}
            </button>
            <button
              class="action-btn void-btn"
              bindtap="voidOrder"
              data-order="{{item}}"
              wx:if="{{item.canVoid || item.canRequestReturn}}"
            >
              {{item.canRequestReturn ? '退单' : '作废'}}
            </button>
            <button
              class="action-btn report-btn"
              bindtap="reportOrderToMall"
              data-order="{{item}}"
              wx:if="{{item.status === '已归档' && userInfo.userRole === 'store_admin' && (!item.reportToMall || item.reportToMall.status !== 'reported')}}"
            >
              上报商场
            </button>
          </view>
          
          <!-- 金额信息已隐藏 -->
        </view>
      </block>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="empty-icon-placeholder">📋</view>
        <text class="empty-text">暂无订单数据</text>
        <button class="btn btn-primary" type="primary" bindtap="navigateToCreateOrder">新建订单</button>
      </view>
    </view>
    
    <!-- 分页信息 -->
    <view class="pagination-info" wx:if="{{orders.length > 0}}">
      <text class="pagination-text">共 {{total}} 条，已显示 {{orders.length}} 条</text>
    </view>
    
    <!-- 加载更多按钮 -->
    <view class="load-more-section" wx:if="{{hasMore}}">
      <button class="btn-load-more" type="default" bindtap="loadMoreOrders" disabled="{{loading}}">
        {{loading ? '加载中...' : '加载更多'}}
      </button>
    </view>
    
    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
      <text class="no-more-text">没有更多数据了</text>
    </view>
  </view>

  <!-- 金额补录弹窗 -->
  <view class="supplement-modal" wx:if="{{showSupplementModal}}">
    <view class="supplement-mask" bindtap="closeSupplementModal"></view>
    <view class="supplement-content">
      <view class="supplement-header">
        <text class="supplement-title">{{isEditMode ? '修改补录金额' : '金额补录'}}</text>
        <text class="supplement-close" bindtap="closeSupplementModal">×</text>
      </view>

      <scroll-view class="supplement-body" scroll-y="true">
        <!-- 订单信息 -->
        <view class="supplement-order-info">
          <text class="supplement-order-no">订单: {{currentOrder.orderNo}}</text>
        </view>

        <!-- 多个补录项目列表 -->
        <view wx:for="{{supplementRecords}}" wx:key="index" class="supplement-record-item">
          <view class="supplement-record-header">
            <text class="supplement-record-title">补录项目 {{index + 1}}</text>
            <view wx:if="{{supplementRecords.length > 1}}" class="delete-record-btn" bindtap="deleteSupplementRecord" data-index="{{index}}">
              <text class="delete-icon">×</text>
            </view>
          </view>

          <!-- 补录项目选择 -->
          <view class="form-item">
            <text class="form-label">补录项目</text>
            <picker mode="selector" range="{{supplementItemNames}}" bindchange="onSupplementItemChange" data-index="{{index}}">
              <view class="picker-input {{item.selectedSupplementItem ? '' : 'placeholder'}}">
                {{item.selectedSupplementItem || '请选择补录项目'}}
              </view>
            </picker>
          </view>

          <!-- 补录金额 -->
          <view class="form-item">
            <text class="form-label">补录金额</text>
            <view class="amount-input-wrapper">
              <text class="amount-sign {{item.amountType === 'increase' ? 'sign-increase' : 'sign-decrease'}}">{{item.amountType === 'increase' ? '+' : '-'}}</text>
              <input type="digit" placeholder="请输入补录金额" value="{{item.supplementAmount}}" bindinput="onSupplementAmountInput" class="form-input amount-input {{item.amountType === 'increase' ? 'text-increase' : 'text-decrease'}}" data-index="{{index}}" />
            </view>
          </view>

          <!-- 补录内容/说明 -->
          <view class="form-item">
            <text class="form-label">补录内容</text>
            <textarea placeholder="请输入补录内容说明（如教育优惠详情等）" value="{{item.supplementContent}}" bindinput="onSupplementContentInput" class="form-textarea" data-index="{{index}}" maxlength="500" auto-height />
          </view>

          <!-- 补录凭证上传 -->
          <view class="form-item">
            <text class="form-label">补录凭证</text>
            <view class="upload-area">
              <view wx:if="{{item.supplementPhotoUrl}}" class="photo-preview">
                <image src="{{item.supplementPhotoUrl}}" mode="aspectFill" class="preview-image" bindtap="previewSupplementPhoto" data-index="{{index}}"></image>
                <view class="delete-photo" bindtap="deleteSupplementPhoto" data-index="{{index}}">×</view>
              </view>
              <view wx:else class="upload-btn" bindtap="uploadSupplementPhoto" data-index="{{index}}">
                <text class="upload-icon">+</text>
                <text class="upload-text">上传凭证</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 添加补录项目按钮 -->
        <view class="add-supplement-btn" bindtap="addSupplementRecord">
          <text class="add-icon">+</text>
          <text class="add-text">添加补录项目</text>
        </view>
      </scroll-view>

      <view class="supplement-footer">
        <button class="btn btn-secondary" type="default" bindtap="closeSupplementModal">取消</button>
        <button class="btn btn-primary" type="primary" bindtap="submitSupplement">提交</button>
      </view>
    </view>
  </view>

  <!-- 提货运费弹窗 -->
  <view class="freight-modal" wx:if="{{showFreightModal}}">
    <view class="freight-mask" bindtap="closeFreightModal" catchtouchmove="noop"></view>
    <view class="freight-content" catchtouchmove="noop">
      <view class="freight-header">
        <text class="freight-title">{{currentOrder && currentOrder.freightAmount !== undefined && currentOrder.freightAmount !== null && currentOrder.freightAmount !== '' ? '修改提货运费' : '提货运费'}}</text>
        <text class="freight-close" bindtap="closeFreightModal">×</text>
      </view>

      <view class="freight-body">
        <view class="form-item">
          <text class="form-label">运费金额</text>
          <input type="digit" placeholder="请输入运费金额" value="{{freightAmount}}" bindinput="onFreightAmountInput" class="form-input" />
        </view>
      </view>

      <view class="freight-footer">
        <button class="btn btn-secondary" type="default" bindtap="closeFreightModal">取消</button>
        <button class="btn btn-primary" type="primary" bindtap="submitFreight">提交</button>
      </view>
    </view>
  </view>

  <!-- 订单备注弹窗 -->
  <view class="remark-modal" wx:if="{{showRemarkModal}}">
    <view class="remark-mask" bindtap="closeRemarkModal" catchtouchmove="noop"></view>
    <view class="remark-content" catchtouchmove="noop">
      <view class="remark-header">
        <text class="remark-title">{{currentOrder && currentOrder.remark ? '修改备注' : '添加备注'}}</text>
        <text class="remark-close" bindtap="closeRemarkModal">×</text>
      </view>

      <view class="remark-body">
        <!-- 订单信息 -->
        <view class="remark-order-info">
          <text class="remark-order-no">订单: {{currentOrder.orderNo}}</text>
        </view>

        <!-- 备注输入 -->
        <view class="form-item">
          <text class="form-label">备注内容</text>
          <textarea
            class="remark-textarea"
            placeholder="请输入备注内容..."
            value="{{remarkText}}"
            bindinput="onRemarkInput"
            maxlength="-1"
            auto-height
          />
        </view>
      </view>

      <view class="remark-footer">
        <button class="btn btn-secondary" type="default" bindtap="closeRemarkModal">取消</button>
        <button class="btn btn-primary" type="primary" bindtap="submitRemark">提交</button>
      </view>
    </view>
  </view>

  <!-- 可用资源弹窗 -->
  <view class="resource-modal" wx:if="{{showResourceModal}}">
    <view class="resource-mask" bindtap="closeResourceModal"></view>
    <view class="resource-content">
      <view class="resource-header">
        <text class="resource-title">可用资源 · {{resourceModalOrder.orderNo}}</text>
        <text class="resource-close" bindtap="closeResourceModal">×</text>
      </view>
      <scroll-view class="resource-body" scroll-y="true">
        <view class="loading-tip" wx:if="{{resourceModalLoading}}"><text class="loading-text">正在加载资源...</text></view>
        <view class="resource-empty" wx:elif="{{resourceRows.length === 0}}">暂无商品资源信息</view>
        <block wx:else>
          <view class="resource-product" wx:for="{{resourceRows}}" wx:key="index">
          <view class="resource-product-title">{{item.productName}} × {{item.quantity}}</view>
          <view class="resource-product-code" wx:if="{{item.pnCode || item.snCode}}">PN {{item.pnCode || '-'}} · SN {{item.snCode || '-'}}</view>
          <view class="resource-label">可用资源</view>
          <view class="resource-tags" wx:if="{{item.hasAvailable}}">
            <text class="resource-tag available" wx:for="{{item.availableResources}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="resource-none" wx:else>暂无可用资源</text>
          <view class="resource-unavailable" wx:if="{{item.unavailableResources.length}}">{{item.unavailableResources.join(' · ')}}</view>
          </view>
        </block>
      </scroll-view>
      <view class="resource-footer"><button class="btn btn-secondary" type="default" bindtap="closeResourceModal">关闭</button></view>
    </view>
  </view>

  <!-- 毛利预估明细弹窗 -->
  <view class="gross-profit-modal" wx:if="{{showGrossProfitModal}}">
    <view class="gross-profit-mask" bindtap="closeGrossProfitModal"></view>
    <view class="gross-profit-content">
      <view class="gross-profit-header">
        <view>
          <text class="gross-profit-title">毛利预估</text>
          <text class="gross-profit-order-no">{{grossProfitModalOrder.orderNo}}</text>
        </view>
        <text class="gross-profit-close" bindtap="closeGrossProfitModal">×</text>
      </view>

      <scroll-view class="gross-profit-body" scroll-y>
        <view class="gross-profit-total {{grossProfitDetail.grossProfitTone}}">
          <text class="gross-profit-total-label">毛利预估</text>
          <text class="gross-profit-total-value">{{grossProfitDetail.grossProfitText}}</text>
        </view>

        <view class="gross-profit-loading" wx:if="{{grossProfitModalLoading}}">正在加载毛利明细...</view>
        <block wx:else>
          <view class="gross-profit-breakdown">
            <view class="gross-profit-line"><text>用户应收</text><text>{{grossProfitDetail.receivableText}}</text></view>
            <view class="gross-profit-line"><text>商品定价</text><text class="profit-minus">- {{grossProfitDetail.productPricingText}}</text></view>
            <view class="gross-profit-line"><text>支付手续费</text><text class="profit-minus">- {{grossProfitDetail.paymentFeeText}}</text></view>
            <view class="gross-profit-line"><text>开票金额</text><text>{{grossProfitDetail.invoiceText}}</text></view>
            <view class="gross-profit-line"><text>增值税</text><text class="profit-minus">- {{grossProfitDetail.vatText}}</text></view>
            <view class="gross-profit-line"><text>补录净额</text><text class="profit-plus">+ {{grossProfitDetail.supplementText}}</text></view>
            <view class="gross-profit-line" wx:if="{{grossProfitDetail.externalAdjustmentFee > 0}}"><text>外调费</text><text class="profit-minus">- {{grossProfitDetail.externalAdjustmentText}}</text></view>
          </view>

          <view class="gross-profit-detail-section" wx:if="{{grossProfitDetail.productPricingDetails.length}}">
            <text class="gross-profit-section-title">商品成本明细</text>
            <view class="gross-profit-detail-row" wx:for="{{grossProfitDetail.productPricingDetails}}" wx:key="itemId">
              <text>{{item.displayName}}</text>
              <text>{{item.amountText}}</text>
            </view>
          </view>

          <view class="gross-profit-detail-section" wx:if="{{grossProfitDetail.paymentDetails.length}}">
            <text class="gross-profit-section-title">支付费用明细</text>
            <view class="gross-profit-detail-row" wx:for="{{grossProfitDetail.paymentDetails}}" wx:key="paymentId">
              <text>{{item.displayName}}</text>
              <text>{{item.feeText}}</text>
            </view>
          </view>

          <view class="gross-profit-detail-section" wx:if="{{grossProfitDetail.supplementDetails.length}}">
            <text class="gross-profit-section-title">补录明细</text>
            <view class="gross-profit-detail-row" wx:for="{{grossProfitDetail.supplementDetails}}" wx:key="supplementId">
              <text>{{item.displayName}}</text>
              <text class="{{item.amountType === 'decrease' ? 'profit-minus' : 'profit-plus'}}">{{item.amountText}}</text>
            </view>
          </view>

          <text class="gross-profit-formula" wx:if="{{grossProfitDetail.formula}}">{{grossProfitDetail.formula}}</text>
        </block>
      </scroll-view>
      <view class="gross-profit-footer"><button class="btn btn-secondary" type="default" bindtap="closeGrossProfitModal">关闭</button></view>
    </view>
  </view>

  <!-- 我的导出任务弹窗 -->
  <view class="export-tasks-modal-wrapper {{showExportTasksModal ? 'show' : ''}}" wx:if="{{showExportTasksModal}}">
    <view class="export-tasks-mask" bindtap="closeExportTasksModal"></view>
    <view class="export-tasks-content-wrapper">
      <view class="export-tasks-header">
        <text class="export-tasks-title">我的导出任务</text>
        <text class="export-tasks-close" bindtap="closeExportTasksModal">×</text>
      </view>

      <view class="export-tasks-body">
        <!-- 加载中 -->
        <view class="loading-tip" wx:if="{{loadingExportTasks}}">
          <text class="loading-text">加载中...</text>
        </view>

        <!-- 空状态 -->
        <view class="empty-tip" wx:elif="{{exportTasks.length === 0}}">
          <text class="empty-text">暂无导出任务</text>
        </view>

        <!-- 任务列表 -->
        <scroll-view class="export-tasks-list" scroll-y wx:else>
          <view class="export-task-item" wx:for="{{exportTasks}}" wx:key="_id">
            <view class="task-header">
              <text class="task-name">{{item.fileName || '处理中...'}}</text>
              <text class="task-status {{item.status}}">{{item.statusText}}</text>
            </view>
            <view class="task-info">
              <text class="task-time">{{item.createTimeFormat}}</text>
              <text class="task-count" wx:if="{{item.totalOrders}}">{{item.totalOrders}}条订单</text>
            </view>
            <view class="task-progress" wx:if="{{item.status === 'processing'}}">
              <view class="progress-bar">
                <view class="progress-fill" style="width: {{item.progress}}%"></view>
              </view>
              <text class="progress-text">{{item.progress}}%</text>
            </view>
            <view class="task-error" wx:if="{{item.status === 'failed' && item.errorMessage}}">
              <text class="error-text">{{item.errorMessage}}</text>
            </view>
            <view class="task-actions" wx:if="{{item.status === 'completed'}}">
              <button class="btn-download" type="primary" size="mini" bindtap="downloadExportFile" data-url="{{item.downloadUrl}}" data-filename="{{item.fileName}}">下载文件</button>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="export-tasks-footer">
        <button class="btn btn-secondary" type="default" bindtap="closeExportTasksModal">关闭</button>
        <button class="btn btn-primary" type="primary" bindtap="refreshExportTasks">刷新</button>
      </view>
    </view>
  </view>

</view>
