.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #f5f6f8; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.05); }
.head-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 22rpx; }
.type-tag { padding: 6rpx 12rpx; border-radius: 8rpx; color: #fff; background: #409eff; font-size: 22rpx; }
.record-no { flex: 1; min-width: 0; color: #30343b; font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status { color: #a66b00; font-size: 24rpx; }
.status-approved { color: #1aad19; }.status-rejected { color: #d93025; }.status-revoked, .status-cancelled { color: #909399; }
.section-title { display: block; margin-bottom: 20rpx; color: #1f2937; font-size: 32rpx; font-weight: 600; }
.info-row { display: flex; align-items: flex-start; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid #edf0f2; line-height: 1.5; }
.label { flex: 0 0 150rpx; color: #7c858f; font-size: 25rpx; }.value { flex: 1; min-width: 0; color: #30343b; font-size: 26rpx; word-break: break-all; }.highlight { color: #1aad19; font-weight: 600; }.amount { color: #d94f3d; font-weight: 600; }
.review-box { margin-top: 22rpx; padding: 20rpx; border-radius: 12rpx; background: #f7faf8; }.review-title, .review-content, .review-meta { display: block; }.review-title { color: #374151; font-size: 26rpx; font-weight: 600; }.review-content { margin-top: 12rpx; color: #20252b; font-size: 27rpx; line-height: 1.6; }.review-meta { margin-top: 10rpx; color: #909399; font-size: 23rpx; }
.sub-title { display: block; margin-top: 24rpx; color: #374151; font-size: 27rpx; font-weight: 600; }.item-row { display: flex; gap: 12rpx; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #edf0f2; color: #606266; font-size: 24rpx; }.item-name { flex: 1; min-width: 0; color: #20252b; }
.loading, .error { padding: 140rpx 20rpx; text-align: center; color: #909399; font-size: 27rpx; }
