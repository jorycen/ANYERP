.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

.loading-state {
  padding: 160rpx 0;
  color: #98a2b3;
  font-size: 27rpx;
  text-align: center;
}

.summary-card,
.product-card {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(31, 45, 61, 0.06);
}

.summary-card {
  padding: 28rpx;
}

.summary-head,
.product-head,
.product-title-wrap,
.pn-row,
.row-title,
.readonly-row,
.allocation-foot,
.bottom-actions {
  display: flex;
  align-items: center;
}

.summary-head,
.product-head,
.row-title,
.readonly-row,
.allocation-foot {
  justify-content: space-between;
}

.summary-label {
  display: block;
  color: #98a2b3;
  font-size: 23rpx;
}

.summary-no {
  display: block;
  margin-top: 8rpx;
  color: #1d2939;
  font-size: 31rpx;
  font-weight: 600;
}

.status-tag,
.type-tag,
.quantity-tag {
  display: inline-block;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag {
  padding: 8rpx 17rpx;
}

.status-tag.pending {
  color: #d97706;
  background: #fff7e6;
}

.status-tag.completed {
  color: #07883f;
  background: #eafaf1;
}

.status-tag.partial {
  color: #b54708;
  background: #fff4e5;
}

.status-tag.partially_received {
  color: #b54708;
  background: #fff4e5;
}

.status-tag.returned {
  color: #667085;
  background: #f2f4f7;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f4;
}

.summary-item {
  width: 50%;
  margin-bottom: 22rpx;
}

.summary-item.wide {
  width: 100%;
  margin-bottom: 0;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  color: #344054;
  font-size: 27rpx;
}

.summary-value.amount {
  color: #ef6c00;
  font-weight: 600;
}

.edit-tip,
.readonly-tip {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.edit-tip {
  color: #8a5a00;
  background: #fff8e8;
}

.readonly-tip {
  color: #475467;
  background: #eef4ff;
}

.product-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.product-head {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.receive-toggle {
  flex-shrink: 0;
  height: 56rpx;
  margin: 0 0 0 12rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 28rpx;
  background: #fff;
  color: #667085;
  font-size: 22rpx;
  line-height: 54rpx;
}

.receive-toggle.selected {
  border-color: #07c160;
  background: #eafaf1;
  color: #07883f;
}

.receive-toggle::after {
  border: 0;
}

.product-title-wrap {
  flex: 1;
  min-width: 0;
}

.product-index {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #eafaf1;
  color: #07883f;
  font-size: 23rpx;
  line-height: 46rpx;
  text-align: center;
}

.product-name {
  margin-left: 14rpx;
  color: #1d2939;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.type-tag {
  padding: 5rpx 12rpx;
  color: #b45309;
  background: #fff7e6;
}

.quantity-tag {
  margin-left: 8rpx;
  padding: 5rpx 12rpx;
  color: #475467;
  background: #f2f4f7;
}

.field-block {
  margin-top: 22rpx;
}

.field-block.compact {
  margin-top: 16rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 24rpx;
}

.text-input,
.picker-display {
  height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  background: #fff;
  color: #1d2939;
  font-size: 27rpx;
}

.text-input {
  flex: 1;
}

.text-input.single {
  width: 100%;
}

.choose-button,
.scan-button {
  width: 112rpx;
  height: 72rpx;
  margin: 0 0 0 14rpx;
  padding: 0;
  border: 0;
  border-radius: 10rpx;
  background: #eefaf3;
  color: #07883f;
  font-size: 25rpx;
  line-height: 72rpx;
  text-align: center;
}

.scan-button::after {
  border: 0;
}

.inventory-picker {
  display: block;
}

.picker-display {
  line-height: 72rpx;
}

.row-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e8ebef;
  border-radius: 12rpx;
  background: #fafbfc;
}

.row-title {
  color: #475467;
  font-size: 25rpx;
  font-weight: 600;
}

.delete-link {
  color: #d92d20;
  font-weight: 400;
}

.defer-button {
  flex-shrink: 0;
  height: 52rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #07c160;
  border-radius: 26rpx;
  background: #eafaf1;
  color: #07883f;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.defer-button::after {
  border: 0;
}

.allocation-foot {
  margin-top: 18rpx;
  color: #667085;
  font-size: 24rpx;
}

.add-row {
  color: #07883f;
}

.mismatch {
  color: #d92d20;
}

.readonly-items {
  padding-top: 12rpx;
}

.skip-tip {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  color: #667085;
  background: #f2f4f7;
  font-size: 24rpx;
}

.readonly-row {
  padding: 14rpx 0;
  color: #667085;
  font-size: 26rpx;
}

.readonly-row text:last-child {
  color: #1d2939;
}

.bottom-space {
  height: 140rpx;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  gap: 18rpx;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8ebef;
  background: #fff;
  box-shadow: 0 -4rpx 18rpx rgba(31, 45, 61, 0.06);
}

.draft-button,
.submit-button {
  height: 82rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.draft-button {
  width: 210rpx;
  border: 1rpx solid #cfd5dc;
  background: #fff;
  color: #475467;
}

.submit-button {
  flex: 1;
  background: #07c160;
  color: #fff;
}
