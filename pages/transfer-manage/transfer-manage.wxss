.container {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f5f7f8;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #08b83e;
  color: #fff;
}

.back-btn {
  width: 72rpx;
  height: 68rpx;
  line-height: 60rpx;
  font-size: 64rpx;
  font-weight: 300;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
}

.refresh-btn {
  width: 142rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .75);
  border-radius: 36rpx;
  background: transparent;
  color: #fff;
  font-size: 25rpx;
  line-height: 62rpx;
}

.region-warning {
  margin: 28rpx 28rpx 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: #fff7e3;
  color: #bd7600;
  font-size: 25rpx;
  line-height: 1.5;
}

.panel {
  margin: 22rpx 28rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(33, 46, 56, .05);
}

.panel-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  background: #08b83e;
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
}

.panel-title {
  color: #222;
  font-size: 36rpx;
  font-weight: 600;
}

.panel-hint,
.action-hint {
  margin: 0 0 24rpx;
  color: #888;
  font-size: 25rpx;
  line-height: 1.6;
}

.store-picker-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.store-picker-row:first-of-type {
  border-top: 1rpx solid #edf0f2;
}

.label {
  width: 172rpx;
  flex-shrink: 0;
  color: #333;
  font-size: 29rpx;
}

.picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 90rpx;
  color: #333;
  font-size: 29rpx;
}

.arrow {
  color: #666;
  font-size: 44rpx;
  line-height: 1;
}

.product-picker {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #e1e5e8;
  border-radius: 18rpx;
  background: #fafbfc;
}

.product-picker-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #eef2f4;
  color: #777;
  font-size: 42rpx;
}

.product-picker-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.product-picker-title {
  overflow: hidden;
  color: #333;
  font-size: 29rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-picker-desc,
.selected-meta {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}

.selected-picker .product-picker-title {
  color: #08a83b;
}

.selected-product {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #b9ebc7;
  border-radius: 18rpx;
  background: #f4fff6;
}

.transfer-items {
  margin-top: 22rpx;
}

.transfer-item-form {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #b9ebc7;
  border-radius: 18rpx;
  background: #f4fff6;
}

.transfer-item-form:first-child {
  margin-top: 0;
}

.transfer-item-form-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.transfer-item-form-head .product-picker-content {
  min-width: 0;
}

.transfer-item-form .quantity-row {
  margin-top: 16rpx;
  background: #fff;
}

.transfer-item-form .link-btn {
  flex-shrink: 0;
}

.selected-label,
.required-title {
  display: block;
  color: #08a83b;
  font-size: 24rpx;
}

.selected-name {
  display: block;
  max-width: 520rpx;
  margin-top: 8rpx;
  color: #222;
  font-size: 29rpx;
  font-weight: 600;
}

.link-btn {
  width: 100rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #08a83b;
  font-size: 26rpx;
}

.quantity-row {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e4e7e9;
  border-radius: 14rpx;
}

.quantity-input {
  flex: 1;
  color: #222;
  font-size: 29rpx;
  text-align: right;
}

.submit-btn {
  height: 84rpx;
  margin: 28rpx 0 0;
  border-radius: 14rpx;
  background: #08b83e;
  color: #fff;
  font-size: 30rpx;
  line-height: 84rpx;
}

.submit-btn[disabled] {
  background: #dfe3e5;
  color: #999;
}

.empty-state {
  padding: 56rpx 0 32rpx;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

.transfer-item {
  padding: 26rpx 0;
  border-top: 1rpx solid #edf0f2;
}

.transfer-head,
.transfer-meta,
.transfer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.transfer-no {
  color: #222;
  font-size: 28rpx;
  font-weight: 600;
}

.status {
  color: #1683ed;
  font-size: 25rpx;
}

.transfer-meta {
  margin-top: 14rpx;
  color: #444;
  font-size: 28rpx;
}

.transfer-time {
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
}

.requested-items {
  margin-top: 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f8f9;
}

.requested-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  color: #555;
  font-size: 25rpx;
  line-height: 1.5;
}

.requested-name {
  flex: 1;
  color: #333;
  font-weight: 500;
}

.requested-detail {
  display: block;
  margin-top: 6rpx;
  color: #777;
  font-size: 24rpx;
}

.receiving-item {
  display: block;
}

.receiving-location-picker {
  margin-top: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe4e7;
  border-radius: 12rpx;
  background: #fff;
}

.receiving-location-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  color: #333;
  font-size: 26rpx;
}

.transfer-actions {
  justify-content: flex-end;
  margin-top: 20rpx;
}

.decision-actions {
  justify-content: flex-start;
}

.decision-actions .small-btn {
  margin-left: 0;
}

.decision-actions .small-btn + .small-btn {
  margin-left: 16rpx;
}

.small-btn {
  min-width: 160rpx;
  height: 68rpx;
  margin: 0 0 0 16rpx;
  border-radius: 12rpx;
  background: #f0f2f3;
  color: #444;
  font-size: 26rpx;
  line-height: 68rpx;
}

.small-btn.primary {
  background: #08b83e;
  color: #fff;
}

.small-btn.danger {
  background: #fff1f0;
  color: #d93025;
}

.request-actions {
  margin-top: 12rpx;
}

.action-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #c9edd2;
  border-radius: 18rpx;
  background: #f8fff9;
}

.action-title {
  margin-bottom: 12rpx;
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
}

.search-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.search-input,
.form-input {
  flex: 1;
  box-sizing: border-box;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe4e7;
  border-radius: 14rpx;
  background: #fff;
  color: #222;
  font-size: 28rpx;
}

.search-btn {
  width: 132rpx;
  height: 78rpx;
  margin: 0 0 0 16rpx;
  border-radius: 14rpx;
  background: #08b83e;
  color: #fff;
  font-size: 28rpx;
  line-height: 78rpx;
}

.product-list {
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e4e8ea;
  border-radius: 14rpx;
  background: #fff;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.product-item:last-child {
  border-bottom: 0;
}

.product-item.active {
  background: #f0fff3;
}

.product-content {
  flex: 1;
  min-width: 0;
}

.product-name {
  color: #222;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 10rpx;
  color: #777;
  font-size: 24rpx;
}

.required-field {
  margin-top: 18rpx;
}

.select-field {
  margin-top: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dfe4e7;
  border-radius: 14rpx;
  background: #fff;
}

.option-picker {
  display: block;
}

.select-field .picker-value {
  min-height: 78rpx;
}

.required-title {
  margin-bottom: 10rpx;
  color: #333;
}

.required {
  margin-left: 8rpx;
  color: #ed4b43;
}

.required-input {
  width: 100%;
}

.actual-selected {
  margin-top: 18rpx;
}

.photo-btn {
  height: 82rpx;
  margin: 22rpx 0 0;
  border: 1rpx dashed #08b83e;
  border-radius: 14rpx;
  background: #fff;
  color: #08a83b;
  font-size: 27rpx;
  line-height: 80rpx;
}

.photo-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo-thumb {
  width: 126rpx;
  height: 126rpx;
  border-radius: 12rpx;
  background: #eee;
}

.multi-sn-field {
  margin: 18rpx 0;
  padding: 18rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 14rpx;
  background: #fafbfb;
}

.sn-option {
  display: flex;
  align-items: center;
  min-height: 70rpx;
  border-bottom: 1rpx solid #edf0f2;
  color: #333;
  font-size: 26rpx;
}

.sn-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border: 2rpx solid #b9c0c4;
  border-radius: 6rpx;
  background: #fff;
  color: #fff;
  font-size: 25rpx;
  line-height: 1;
}

.sn-checkbox.checked {
  border-color: #08b83e;
  background: #08b83e;
}

.sn-option:last-child {
  border-bottom: 0;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, .42);
}

.product-modal {
  width: 100%;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  color: #222;
  font-size: 34rpx;
  font-weight: 600;
}

.modal-close {
  color: #777;
  font-size: 52rpx;
  line-height: 1;
}

.modal-store-hint {
  margin-top: 10rpx;
  color: #888;
  font-size: 24rpx;
}

.modal-search-row {
  margin-top: 18rpx;
}

.modal-results-title {
  margin: 22rpx 0 12rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #08b83e;
  color: #444;
  font-size: 27rpx;
}

.modal-product-list {
  max-height: 48vh;
  border: 1rpx solid #edf0f2;
  border-radius: 14rpx;
}

.select-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border: 2rpx solid #b9c0c4;
  border-radius: 50%;
  color: transparent;
  font-size: 25rpx;
}

.modal-product-list .product-item:active .select-dot {
  border-color: #08b83e;
  background: #08b83e;
  color: #fff;
}

.modal-empty {
  padding: 70rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

.modal-cancel {
  height: 76rpx;
  margin: 22rpx 0 0;
  border-radius: 14rpx;
  background: #f0f2f3;
  color: #555;
  font-size: 28rpx;
  line-height: 76rpx;
}
